      letter-spacing: 1px;
      color: #555;
    }

    .breadcrumb a {
      color: #1a73e8;
      text-decoration: none;
    }

    .tabs {
      display: flex;
      border-bottom: 1px solid #ddd;
      margin-bottom: 20px;
    }

    .tab {
      padding: 10px 20px;
      cursor: pointer;
      font-weight: 500;
      color: #333;
      border-bottom: 3px solid transparent;
      transition: border-bottom 0.3s;
    }

    .tab.active {
      border-bottom: 3px solid #1a73e8;
      color: #1a73e8;
      background: #eef4ff;
      border-top-left-radius: 5px;
      border-top-right-radius: 5px;
    }

    .filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      justify-content: space-between;
    }

    .filter-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    .filter-button,
    .reset-link {
      padding: 8px 12px;
      border: 1px solid #ddd;
      border-radius: 20px;
      background: #fff;
      font-size: 14px;
      cursor: pointer;
    }

    .filter-button:hover,
    .reset-link:hover {
      background: #f0f0f0;
      color: black;
      transition: 0.7s;

    }

    .reset-link {
      color: #1a73e8;
      border: none;
      background: none;
      text-decoration: underline;
    }

    .create-search {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-top: 10px;
    }

    .create-btn {
      background-color: #0061ff;
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      cursor: pointer;
    }

    .search-box {
      display: flex;
      align-items: center;
      border: 1px solid #ddd;
      border-radius: 20px;
      padding: 8px 12px;
      background: white;
    }

    .search-box input {
