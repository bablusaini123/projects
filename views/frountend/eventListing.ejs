    .page-box {
      padding: 8px 12px;
      border: 1px solid #ccc;
      border-radius: 6px;
      text-decoration: none;
      color: #fff;
      font-weight: 500;
      min-width: 40px;
      text-align: center;
      transition: all 0.2s;
      background: #2878d3;
