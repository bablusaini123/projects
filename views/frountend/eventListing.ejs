      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f0f0f0;
    }

    .card-container {
      display: flex;
      flex-wrap: wrap !important;
      /* flex: 1; */
      gap: 33px;
      justify-content: start;
    }

    .card {
