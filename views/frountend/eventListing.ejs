    }

    .footer-title {
      font-size: 16px;
      font-weight: 600;
      color: #1e293b;
      margin-bottom: 20px;
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .footer-link {
      color: #64748b;
      text-decoration: none;
      font-size: 14px;
      transition: color 0.2s;
    }

    .footer-link:hover {
      color: #0b74de;
    }

    .footer-bottom {
      padding-top: 30px;
      border-top: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .copyright {
      font-size: 14px;
      color: #0b74de;
    }

    .scroll-top {
      width: 40px;
      height: 40px;
      background: #0b74de;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      text-decoration: none;
      transition: background 0.2s;
    }

    .scroll-top:hover {
      background: #0b74de;
    }

    @media (max-width: 768px) {
      .footer-container {
        padding: 0 20px;
      }

      .newsletter-form {
        flex-direction: column;
        gap: 12px;
      }

      .email-input {
        border-radius: 8px;
        border-right: 1px solid #d1d5db;
      }

      .subscribe-btn {
        border-radius: 8px;
      }

      .footer-content {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .footer-bottom {
        flex-direction: column;
        gap: 20px;
        text-align: center;
      }

      /* Display the hamburger menu for mobile */
      .hamburger-menu {
        display: block;
      }

      /* Hide the normal desktop navigation */
      nav {
        display: none;
      }

      /* Sidebar active on mobile */
      .sidebar.active {
        display: block;
      }

      .logo a img {
        width: 85% !important;
      }

      header {
        align-items: unset !important;
        flex-wrap: unset !important;
        padding: 15px 14px;
        flex-direction: unset;
        border: 1px solid #eee;
      }

      .hamburger-menu {
        font-size: 24px;
      }

      .logo {
        margin-bottom: 0;
      }

      .dropdown {
        background: #f6f6f6;
      }

      .tab {
        padding: 6px 16px;
        font-weight: 600;
        font-size: 13px;
      }

      .eventBtn {
        padding: 0px 15px;
        background: #55b1ed;
        margin-left: auto;
        color: #000;
        text-decoration: none;
        border-radius: 18px;
        font-weight: 500;
        font-size: 11px;
        align-items: center;
        display: flex;
      }

      .card-container {
        flex-wrap: wrap;
      }

      .card {
        max-width: 100%;
      }

      .bitcoin-guides {
        margin: 0px 10px !important;
        gap: 0 !important;
      }

      .footer-bottom {
        padding-top: 0px;
      }

      .newsletter-section {
        margin-bottom: 17px !important;
        padding-bottom: 20px !important;
      }

      .newsletter-title {
        margin-top: 30px;
      }

      .filters {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }

      .create-search {
        flex-direction: column;
        align-items: flex-start;
        width: 100%;
      }

      .search-box {
        width: 100%;
      }
    }

    .newsletter-title {
      margin-top: 30px;
    }

    @media (max-width: 768px) {
      .footer-container {
        padding: 0 15px;
      }

      .newsletter-form {
        flex-direction: column;
        gap: 10px;
      }

      .email-input {
        border-radius: 6px;
        border-right: 1px solid #d1d5db;
      }

      .subscribe-btn {
        border-radius: 6px;
      }

      .footer-content {
        grid-template-columns: 1fr;
        gap: 20px;
      }

      .footer-bottom {
        flex-direction: column;
        gap: 15px;
        text-align: center;
      }

      /* Hamburger menu for mobile */
      .hamburger-menu {
        display: block;
      }

      /* Hide desktop navigation */
      nav {
        display: none;
      }

      .sidebar.active {
        display: block;
      }

      .logo a img {
        width: 85% !important;
      }

      header {
        align-items: unset !important;
        flex-wrap: unset !important;
        padding: 10px 12px;
        flex-direction: unset;
        border: 1px solid #eee;
      }

      .hamburger-menu {
        font-size: 22px;
      }

      .logo {
        margin-bottom: 0;
      }

      .dropdown {
        background: #f6f6f6;
      }

      .tab {
        padding: 5px 12px;
        font-weight: 600;
        font-size: 12px;
      }

      .eventBtn {
        padding: 8px 12px;
        background: #55b1ed;
        margin-left: auto;
        color: #000;
        text-decoration: none;
        border-radius: 15px;
        font-weight: 500;
        font-size: 10px;
        align-items: center;
        display: flex;
      }

      /* Card container adjustments for two cards per row */
      .card-container {
        flex-wrap: wrap;
        gap: 10px;
        /* Reduced gap for mobile */
        justify-content: space-between;
      }

      .card {
        max-width: calc(50% - 5px);
        /* Two cards per row with small gap */
        flex: 1 1 calc(50% - 5px);
        border-radius: 8px;
      }

      .card-body {
        padding: 10px 6px;
        /* Reduced padding */
      }

      .card-body img {
        border-radius: 5px !important;
      }

      .all_event_h2 {
        font-size: 18px;
      }

      .card-title {
        font-size: 14px;
        /* Smaller font size */
        margin: 5px 0 8px;
      }

      .card-info {
        font-size: 12px;
        /* Smaller font size */
        margin-bottom: 8px;
      }

      .tags {
        gap: 5px;
        /* Reduced gap between tags */
        margin-bottom: 7px;
      }

      .tag {
        font-size: 10px;
        /* Smaller font size for tags */
        padding: 10px 6px;
        border-radius: 50%;
        background: #e0f7e9;
        color: #2e7d32;
      }

      .type {
        font-size: 11px;
        padding-top: 4px;
      }

      .ms-auto img {
        width: 10px;
      }

      .card-footer {
        font-size: 10px;
        padding: 2px !important;
        display: flex;
        flex-direction: column;

        /* Smaller font size */
      }

      /* .card-footer.share-project {
        display: none !important;
      } */

      .card-share span {
        font-size: 12px;
       display: none !important;
        /* Smaller font size for share text */
      }

      .card-share i {
        font-size: 16px;
        /* display: flex; */
        /* gap: 2px; */
        text-decoration: none;
        /* Slightly smaller icons */
      }

      .listingSection {
        margin-top: 5px !important;
      }

      .bitcoin-guides {
        margin: 0 10px !important;
        gap: 0 !important;
      }

      .footer-bottom {
        padding-top: 0;
      }

      .newsletter-section {
        margin-bottom: 15px !important;
        padding-bottom: 15px !important;
      }

      .newsletter-title {
        font-size: 24px;
        /* Smaller font size */
        margin-top: 20px;
        margin-bottom: 20px;
      }

      .filters {
        flex-direction: column;
        align-items: center;
        gap: 10px;
      }

      .filter-button {
        font-size: 12px;
        /* Smaller font size */
        padding: 6px 10px;
      }

      .create-search {
        flex-direction: column;
        align-items: flex-start;
        width: 100%;
      }

      .search-box {
        width: 100%;
      }

      .search-box input {
        font-size: 12px;
        /* Smaller font size */
      }

      .pagination-container {
        gap: 5px;
        /* Reduced gap */
      }

      .page-box {
        font-size: 12px;
        /* Smaller font size */
        padding: 6px 10px;
        min-width: 35px;
      }
      img.shareImg{
        width: 24px !important;
        height: 24px !important;
      }
      .tag {
        font-size: 10px;
        padding: 6px 4px;
        border-radius: 25%;
        background: #e0f7e9;
        color: #2e7d32;
    }
    .logo a img {
        width: 70% !important;
    }

    }
  </style>
</head>

<body>

  <!-- header start -->

  <%- include("../../partials/frountHeader.ejs")%>
    <!-- header end -->

    <section>
      <div class="container">
        <div class="breadcrumb">
          <a href="/" style="color: #555;">Home</a> > <a href="#"> Events</a>
        </div>

        <div class="">
          <div class="tabs">
            <div class="tab active">All Events Listing</div>
            <!-- <div class="tab">Organizers</div>
            <div class="tab">Speakers</div> -->
            <a href="/createEventListing" class="eventBtn">Create Your Event</a>
          </div>
        </div>

        <h2 class="all_event_h2">All Events</h2>

        <div class="filters">
          <div class="filter-group">
            <a href="/events?page=1&category=ongoing" class=""> <button
                class="filter-button <%= selectedCategory == 'ongoing' ? 'active-btn' : '' %>">Ongoing</button> </a>
            <a href="/events?page=1&category=upcoming" class=""><button
                class="filter-button <%= selectedCategory == 'upcoming' ? 'active-btn' : '' %>"> Upcoming</button> </a>
            <a href="/events?page=1&category=ended" class=""> <button
                class="filter-button <%= selectedCategory == 'ended' ? 'active-btn' : '' %>">Ended</button></a>
            <a href="/events?page=1" class=""> <button
                class="filter-button <%= selectedCategory === 'all' ? 'active-btn' : '' %>">All</button> </a>
            <!-- <select class="dropdown">
              <option>All locations</option>
              <option>Osaka</option>
              <option>New York</option>
            </select>

            <select class="dropdown">
              <option>Date</option>
              <option>Today</option>
              <option>This Week</option>
            </select>

            <select class="dropdown">
              <option>Price</option>
              <option>Free</option>
              <option>Paid</option>
            </select>

            <select class="dropdown">
              <option>Event Type</option>
              <option>Seminar</option>
              <option>Expo</option>
            </select>

            <select class="dropdown">
              <option>Tag</option>
              <option>Crypto</option>
              <option>Web3</option>
            </select>

            <span class="reset-link">Reset Filter</span>
          </div>

          <div class="create-search">

            <div class="search-box">
              <svg height="16" width="16" viewBox="0 0 24 24" fill="none">
                <path
                  d="M21 21L15 15M10 18C6.13 18 3 14.87 3 11C3 7.13 6.13 4 10 4C13.87 4 17 7.13 17 11C17 14.87 13.87 18 10 18Z"
                  stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <input type="text" placeholder="Search" />
            </div>
          </div> -->
          </div>


        </div>
    </section>


    <section class="listingSection">
      <div class="container">
        <div class="card-container">
          <!-- Repeat this card 4 times -->
          <% formattedEventListingData.forEach((result,index)=>{ %>
            <div class="card">
              <div class="card-body">
                <div class="tags">
                  <% let categoryClass='' ; if (selectedCategory==='upcoming' ) categoryClass='upcomingTeg' ; else if
                    (selectedCategory==='ongoing' ) categoryClass='ongoingTeg' ; else if (selectedCategory==='ended' )
                    categoryClass='endTeg' ; %>
                    <span class="tag status-badge <%= selectedCategory.toLowerCase() %> <%= categoryClass %>">
                      <%= selectedCategory.charAt(0).toUpperCase() + selectedCategory.slice(1) %>
                    </span>
                    <span class="tag">
                      <%=result.eventType%>
                    </span>
                    <span class="type">🎟 <%=result.entryType%></span>
                    <span class="ms-auto">
                      <a href="">
                        <img class="shareImg" style="width: 33px;opacity: 0.8;"
                          src="../../image/pngtree-share-icon-button-png-image_6454552.png" alt="">
                      </a>
                    </span>
                </div>
                <div>
                  <img style="border-radius: 20px;" src="<%=result.bannerImage%>" alt="<%= result.altText %>">
                </div>
                <div class="card-title truncate-text" title="<%= result.title %>">
                  <%=result.title%>
                </div>
                <div class="card-info truncate-text"
                  title="<%=result.startDateFormatted%> – <%=result.endDateFormatted%>"><img style="width: 30px;"
                    src="../../image/ava13c3ac53812cde1b88.png" alt="">
                  <%=result.startDateFormatted%> – <%=result.endDateFormatted%>
                </div>
                <div class="card-info truncate-text" title="<%=result.location%>"><img style="width: 20px;"
                    src="../../image/free-location-icon-2955-thumb.png" alt="">
                  <%=result.location%>
                </div>
                <div class="card-footer">

                  <!-- Share This Project -->
                  <div class="card-share" style="margin-top: 15px; margin-top: 15px;
      display: flex;
    align-items: center;
    justify-content: space-evenly;
    width: 100%;
">

                      <span style="font-weight: 500; font-size: 14px;" class="share-project">Share project:</span>

                      <!-- 🌐 Social Share Buttons -->
                      <!-- Twitter -->
                      <a href="javascript:window.open('https://twitter.com/intent/tweet?url=' + encodeURIComponent(window.location.origin + '/events/<%= result.slug %>') + '&text=' + encodeURIComponent('<%= result.title %> - 🚀 New Event Launched! Check us out on KryptoDesk!'), '_blank')"
                        title="Share on Twitter">
                        <i class="fab fa-twitter" style="font-size: 18px; color: #1DA1F2;"></i>
                      </a>

                      <!-- Facebook -->
                      <a href="javascript:window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(window.location.origin + '/events/<%= result.slug %>'), '_blank')"
                        title="Share on Facebook">
                        <i class="fab fa-facebook" style="font-size: 18px; color: #4267B2;"></i>
                      </a>


                      <!-- WhatsApp -->
                      <a href="javascript:window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent('<%= result.title %>\n\n' + '🚀 New Event Launched! Check us out on KryptoDesk!' + '\n🌐 ' + window.location.origin + '/events/<%= result.slug %>'), '_blank')"
                        title="Share on WhatsApp">
                        <i class="fab fa-whatsapp" style="font-size: 18px; color: #25D366;"></i>
                      </a>

                      <!-- Copy Link -->
                      <a href="javascript:void(0);"
                        onclick="copyToClipboard(window.location.origin + '/events/<%= result.slug %>')"
                        title="Copy Link">
                        <i class="fas fa-link" style="font-size: 18px; color: #555;"></i>
                      </a>

                  </div>

                  <!-- <a href="events/<%=result.slug%>" class="link">View Details</a> -->
                </div>
              </div>
            </div>
            <% })%>
              <!-- Copy this card 3 more times for 4 cards -->
              <!-- Paste here 3 more identical .card blocks if needed -->
        </div>
        <section style="margin-left: auto;">
          <div class="pagination-container">
            <% if (current> 1) { %>
              <a href="/events?page=<%= current - 1 %>&category=<%= selectedCategory %>" class="page-box">‹</a>
              <% } else { %>
                <span class="page-box disabled">‹</span>
                <% } %>

                  <% if (current> 2) { %>
                    <a href="/events?page=1&category=<%= selectedCategory %>" class="page-box">1</a>
                    <% } %>

                      <% if (current> 3) { %>
                        <span class="page-box dots">...</span>
                        <% } %>

                          <% for (let i=current - 1; i <=current + 1; i++) { if (i> 1 && i < pages) { %>
                              <a href="/events?page=<%= i %>&category=<%= selectedCategory %>"
                                class="page-box <%= current === i ? 'active' : '' %>">
                                <%= i %>
                              </a>
                              <% } } %>

                                <% if (current < pages - 2) { %>
                                  <span class="page-box dots">...</span>
                                  <% } %>

                                    <% if (current < pages - 1) { %>
                                      <a href="/events?page=<%= pages %>&category=<%= selectedCategory %>"
                                        class="page-box">
                                        <%= pages %>
                                      </a>
                                      <% } %>

                                        <% if (current < pages) { %>
                                          <a href="/events?page=<%= current + 1 %>&category=<%= selectedCategory %>"
                                            class="page-box">›</a>
                                          <% } else { %>
                                            <span class="page-box disabled">›</span>
                                            <% } %>
          </div>

        </section>
      </div>

    </section>


    <%- include("../../partials/frountFooter.ejs")%>
      <script>
        function toggleMenu() {
          const nav = document.getElementById('nav');
          nav.classList.toggle('show');
        }
      </script>


      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>

      <script>
        // Hamburger Menu Toggle (for opening and closing the nav)
        // Hamburger menu click (for opening the sidebar)
        document.getElementById('hamburger-menu').addEventListener('click', function () {
          document.getElementById('sidebar').classList.add('active');
        });

        // Close button click (for closing the sidebar)
        document.getElementById('close-btn').addEventListener('click', function () {
          document.getElementById('sidebar').classList.remove('active');
        });
      </script>
      <script>
        function copyToClipboard(text) {
          navigator.clipboard.writeText(text)
            .then(() => alert('Link copied!'))
            .catch(err => alert('Failed to copy!'));
        }
      </script>

</body>

</html>