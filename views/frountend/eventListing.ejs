      outline: none;
      font-size: 14px;
      padding-left: 8px;
    }

    .search-box svg {
      color: #888;
    }



    .eventBtn {
      padding: 11px 36px;
      background: #55b1ed;
      margin-left: auto;
      color: #000;
      text-decoration: none;
      border-radius: 18px;
      font-weight: 600;
    }

    .pagination-container {
      display: flex;
      justify-content: end;
      align-items: center;
      gap: 8px;
      margin-top: 20px;
