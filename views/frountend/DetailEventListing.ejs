<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
   <link rel="icon" href="../../image/tRjsqSe3_400x400.jpg" type="image/x-icon">
   


<!-- Meta Title & Description for Event Detail Page -->
<title><%= eventListingData.title %> - Blockchain & Crypto Event Details | KryptoDesk</title>
<meta name="description" content="Join <%= eventListingData.title %> in <%= eventListingData.country %>. Learn, network, and grow with top speakers and blockchain professionals. Find all details now on KryptoDesk.">


<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "<%= eventListingData.title %>",
  "startDate": "<%= eventListingData.startDate %>",
  "endDate": "<%= eventListingData.endDate %>",
  "eventAttendanceMode": "https://schema.org/MixedEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "Place",
    "name": "<%= eventListingData.country %>",
    "address": "<%= eventListingData.location %>"
  },
  "image": "<%= eventListingData.bannerImage %>",
  "url": "https://kryptodesk.com/events/<%= eventListingData.slug %>"
}
</script>

  <style>
    * {
      box-sizing: border-box;
    }

    

    .breadcrumb {
      font-size: 14px;
      margin: 22px 0px;
      letter-spacing: 1px;
      color: #555;
    }

    .breadcrumb a {
      color: #1a73e8;
      text-decoration: none;
    }

    .seminar {
      padding: 3px 13px;
      font-size: 13px;
      font-weight: 500;
      border-radius: 10px;
      margin-bottom: 13px;
      border: solid 1px;
      background: rgba(22, 197, 130, 0.10);
      color: #16C582;
    }

    .visitWebsite {
      padding: 5px 13px;
      font-size: 13px;
      font-weight: 500;
      border-radius: 10px;
      margin-bottom: 13px;
      border: solid 1px;
      text-decoration: none;
    }
     body {
            /* font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; */
            background: #fff;
            color: #111;
            font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif !important;
            overflow-x: hidden;
            margin: 0;

        }

        h1,
        h2,
        h3,
        p,
        span {
            font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif !important;

        }




        /* Main header styling */
        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 48px;
            border-bottom: 1px solid #eee;
            flex-wrap: wrap;
            /* Wrapping to allow proper stacking in mobile view */
        }

        .logo {
            display: flex;
            align-items: center;
            font-size: 32px;
            font-weight: bold;
            color: #111;
        }

        .hamburger-menu {
            display: none;
            cursor: pointer;
            font-size: 30px;
        }

        /* Normal desktop navigation */
        nav {
            display: flex;
            align-items: center;
            flex-grow: 1;
            white-space: nowrap;
            justify-content: center;
        }

        nav a {
            margin: 0 10px;
            text-decoration: none;
            color: #111;
            font-weight: 500;
        }

        nav a:hover {
            color: #0b74de;
        }

        .dropdown {
            position: relative;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 8px;
            padding: 10px 0;
            z-index: 10;
        }

        .dropdown-content a {
            display: block;
            padding: 10px 15px;
            color: #111;
        }

        .dropdown-content a:hover {
            background: #fafafa;
            color: #0b74de;
        }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        /* Sidebar Styling */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 90%;
            height: 100%;
            background: #fff;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
            transform: translateX(-100%);
            /* Sidebar hidden off-screen initially */
            transition: transform 0.5s ease;
            /* Smooth slide-in transition */
        }

        /* Active state (when sidebar is open) */
        .sidebar.active {
            transform: translateX(0);
            /* Slide-in to the left side */
        }

        .sidebar-logo {

            padding: 20px 12px;

        }

        .sidebar-logo img {
            width: 65% !important;
        }

        .close-btn {
            font-size: 30px;
            color: #111;
            position: absolute;
            top: 20px;
            right: 20px;
            cursor: pointer;
        }


        /* Media Query for Mobile (Less than or equal to 768px) */
        @media (max-width: 768px) {

            /* Display the hamburger menu for mobile */
            .hamburger-menu {
                display: block;
            }

            /* Hide the normal desktop navigation */
            nav {
                display: none;
            }

            /* Sidebar active on mobile */
            .sidebar.active {
                display: block;
            }

            .logo a img {
                width: 85% !important;
            }

            header {
                align-items: unset !important;
                flex-wrap: unset !important;
                padding: 15px 14px;
                flex-direction: unset;
                border: 1px solid #eee;
            }

            .hamburger-menu {
                font-size: 24px;
            }

            .logo {
                margin-bottom: 0;
            }

            .dropdown {
                background: #f6f6f6;
            }

        }

        .dropdown {
            position: relative;
            /* color: #000; */
            padding: 8px 10px;

            margin-bottom: 11px;
        }

        .dropdown a {
            text-decoration: none;
            color: #000;
        }
         .footer {
      background: white;
      padding: 60px 0 40px;
      border-top: 1px solid #e2e8f0;
    }

    .footer-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .newsletter-section {
      text-align: center;
      margin-bottom: 60px;
      padding-bottom: 40px;
      border-bottom: 1px solid #e2e8f0;
    }

    .newsletter-title {
      font-size: 28px;
      font-weight: 700;
      color: #0b74de;
      margin-bottom: 30px;
    }

    .newsletter-form {
      display: flex;
      max-width: 500px;
      margin: 0 auto 20px;
      gap: 0;
    }

    .email-input {
      flex: 1;
      padding: 12px 20px;
      border: 1px solid #d1d5db;
      border-radius: 8px 0 0 8px;
      font-size: 14px;
      outline: none;
      border-right: none;
    }

    .email-input:focus {
      border-color: #0b74de;
    }

    .subscribe-btn {
      background: #0b74de;
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 0 8px 8px 0;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .subscribe-btn:hover {
      background: #0b74de;
    }

    .subscribe-btn::after {
      content: '>';
      font-weight: bold;
    }

    .checkbox-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-bottom: 15px;
    }

    .checkbox {
      width: 16px;
      height: 16px;
    }

    .checkbox-label {
      font-size: 14px;
      color: #64748b;
    }

    .privacy-text {
      font-size: 12px;
      color: #94a3b8;
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.4;
    }

    .privacy-link {
      color: #0b74de;
      text-decoration: none;
    }

    .privacy-link:hover {
      text-decoration: underline;
    }

    .footer-content {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 40px;
    }

    .footer-brand {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .logo-icon {
      width: 32px;
      height: 32px;
      background: #0b74de;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
      font-size: 14px;
    }

    .logo-text {
      font-size: 20px;
      font-weight: 700;
      color: #1e293b;
    }

    .social-links {
      display: flex;
      gap: 12px;
    }

    .social-link {
      width: 36px;
      height: 36px;
      background: #f1f5f9;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #64748b;
      text-decoration: none;
      transition: all 0.2s;
    }

    .social-link:hover {
      background: #0b74de;
      color: white;
    }

    .footer-column {
      display: flex;
      flex-direction: column;
    }

    .footer-title {
      font-size: 16px;
      font-weight: 600;
      color: #1e293b;
      margin-bottom: 20px;
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .footer-link {
      color: #64748b;
      text-decoration: none;
      font-size: 14px;
      transition: color 0.2s;
    }

    .footer-link:hover {
      color: #0b74de;
    }

    .footer-bottom {
      padding-top: 30px;
      border-top: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .copyright {
      font-size: 14px;
      color: #0b74de;
    }

    .scroll-top {
      width: 40px;
      height: 40px;
      background: #0b74de;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      text-decoration: none;
      transition: background 0.2s;
    }

    .scroll-top:hover {
      background: #0b74de;
    }

   @media (max-width: 768px) {
      .footer-container {
        padding: 0 20px;
      }

      .newsletter-form {
        flex-direction: column;
        gap: 12px;
      }

      .email-input {
        border-radius: 8px;
        border-right: 1px solid #d1d5db;
      }

      .subscribe-btn {
        border-radius: 8px;
      }

      .footer-content {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .footer-bottom {
        flex-direction: column;
        gap: 20px;
        text-align: center;
      }
       /* Display the hamburger menu for mobile */
      .hamburger-menu {
        display: block;
      }

      /* Hide the normal desktop navigation */
      nav {
        display: none;
      }

      /* Sidebar active on mobile */
      .sidebar.active {
        display: block;
      }

      .logo a img {
        width: 85% !important;
      }

      header {
        align-items: unset !important;
        flex-wrap: unset !important;
        padding: 15px 14px;
        flex-direction: unset;
        border: 1px solid #eee;
      }

      .hamburger-menu {
        font-size: 24px;
      }

      .logo {
        margin-bottom: 0;
      }

      .dropdown {
        background: #f6f6f6;
      }

      .tab {
        padding: 6px 16px;
        font-weight: 600;
        font-size: 13px;
      }

      .eventBtn {
        padding: 0px 15px;
        background: #55b1ed;
        margin-left: auto;
        color: #000;
        text-decoration: none;
        border-radius: 18px;
        font-weight: 500;
        font-size: 11px;
        align-items: center;
        display: flex;
      }

      .card-container {
        flex-wrap: wrap;
      }

      .card {
        max-width: 100%;
      }

      .bitcoin-guides {
        margin: 0px 10px !important;
        gap: 0 !important;
      }

      .footer-bottom {
        padding-top: 0px;
      }

      .newsletter-section {
        margin-bottom: 17px !important;
        padding-bottom: 20px !important;
      }
      .newsletter-title{
        margin-top: 30px;
      }
       .filters {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }

      .create-search {
        flex-direction: column;
        align-items: flex-start;
        width: 100%;
      }

      .search-box {
        width: 100%;
      }
    }

    .newsletter-title{
        margin-top: 30px;
      }
  </style>

</head>

<body>

  <!-- header start -->

  <%- include("../../partials/frountHeader.ejs")%>
    <!-- header end -->


    <section>
      <div class="container">
        <div class="col-md-8">
          <div class="breadcrumb">
            <a href="/" style="color: #555;">Home </a> ><a href="/eventListing" style="color: #555;">Events </a> > <a
              href="#">
              <%=eventListingData.title%>
            </a>
          </div>
          <button class="seminar">
            <%=eventListingData.eventType%>
          </button>

          <h2>
            <%=eventListingData.title%>
          </h2>
          <div style="margin: 13px 0px;color: #605e5e;" class="card-info">📍 <%=eventListingData.location%>
          </div>
          <div class="card-info">📅 <%=eventListingData.startDateFormatted%> – <%=eventListingData.endDateFormatted%>
          </div>
          <button class="seminar mt-3">
            <%=eventListingData.eventType%>
          </button>
          <a href="<%=eventListingData.website%>" target="_blank" class="visitWebsite">visit Website</a>
          <img style="width: 100%;" src="<%=eventListingData.bannerImage%>" alt="">

          <div class="event-description">
            <%- eventListingData.description %>
          </div>

        </div>
        <div class="col-md-4">

        </div>

      </div>

    </section>

    
    <%- include("../../partials/frountFooter.ejs")%>

 <script>
                // Hamburger Menu Toggle (for opening and closing the nav)
                // Hamburger menu click (for opening the sidebar)
                document.getElementById('hamburger-menu').addEventListener('click', function () {
                    document.getElementById('sidebar').classList.add('active');
                });

                // Close button click (for closing the sidebar)
                document.getElementById('close-btn').addEventListener('click', function () {
                    document.getElementById('sidebar').classList.remove('active');
                });


            </script>

</body>

</html>