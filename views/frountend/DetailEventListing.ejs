<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />


  <title>iNDEX</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f0f0f0;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 15px 20px;
      background-color: #333;
      color: white;
      flex-wrap: wrap;
    }

    .logo {
      font-size: 1.5rem;
      font-weight: bold;
    }

    .search-bar {
      flex: 1 1 300px;
      margin: 10px 20px;
    }

    .search-bar input {
      width: 100%;
      padding: 8px 10px;
      border-radius: 20px;
      border: none;
      font-size: 1rem;
    }

    nav {
      display: flex;
      gap: 15px;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: 500;
      padding: 6px 10px;
      transition: background 0.3s;
    }

    nav a:hover {
      background-color: #555;
      border-radius: 5px;
    }

    .menu-toggle {
      display: none;
      flex-direction: column;
      cursor: pointer;
    }

    .menu-toggle span {
      width: 25px;
      height: 3px;
      background: white;
      margin: 4px 0;
    }

    @media (max-width: 768px) {
      .search-bar {
        flex: 1 1 100%;
        order: 3;
        margin: 10px 0;
      }

      nav {
        display: none;
        flex-direction: column;
        width: 100%;
        margin-top: 10px;
        background-color: #444;
        order: 4;
      }

      nav a {
        padding: 10px;
        border-top: 1px solid #555;
      }

      nav.show {
        display: flex;
      }

      .menu-toggle {
        display: flex;
      }
    }

    .breadcrumb {
      font-size: 14px;
      margin: 22px 0px;
      letter-spacing: 1px;
      color: #555;
    }

    .breadcrumb a {
      color: #1a73e8;
      text-decoration: none;
    }

    .seminar {
      padding: 3px 13px;
      font-size: 13px;
      font-weight: 500;
      border-radius: 10px;
      margin-bottom: 13px;
      border: solid 1px;
      background: rgba(22, 197, 130, 0.10);
      color: #16C582;
    }

    .visitWebsite {
      padding: 5px 13px;
      font-size: 13px;
      font-weight: 500;
      border-radius: 10px;
      margin-bottom: 13px;
      border: solid 1px;
      text-decoration: none;
    }
  </style>

</head>

<body>

  <!-- header start -->

  <%- include("../../partials/frountHeader.ejs")%>
    <!-- header end -->


    <section>
      <div class="container">
        <div class="col-md-8">
          <div class="breadcrumb">
            <a href="/" style="color: #555;">Home </a> ><a href="/eventListing" style="color: #555;">Events </a> > <a
              href="#">
              <%=eventListingData.title%>
            </a>
          </div>
          <button class="seminar">
            <%=eventListingData.eventType%>
          </button>

          <h2>
            <%=eventListingData.title%>
          </h2>
          <div style="margin: 13px 0px;color: #605e5e;" class="card-info">📍 <%=eventListingData.location%>
          </div>
          <div class="card-info">📅 <%=eventListingData.startDateFormatted%> – <%=eventListingData.endDateFormatted%>
          </div>
          <button class="seminar mt-3">
            <%=eventListingData.eventType%>
          </button>
          <a href="<%=eventListingData.website%>" target="_blank" class="visitWebsite">visit Website</a>
          <img style="width: 100%;" src="<%=eventListingData.bannerImage%>" alt="">

          <div class="event-description">
            <%- eventListingData.description %>
          </div>

        </div>
        <div class="col-md-4">

        </div>

      </div>

    </section>




</body>

</html>