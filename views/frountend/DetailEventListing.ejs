<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />


  <title>iNDEX</title>

  <style>
    * {
      box-sizing: border-box;
    }

    

    .breadcrumb {
      font-size: 14px;
      margin: 22px 0px;
      letter-spacing: 1px;
      color: #555;
    }

    .breadcrumb a {
      color: #1a73e8;
      text-decoration: none;
    }

    .seminar {
      padding: 3px 13px;
      font-size: 13px;
      font-weight: 500;
      border-radius: 10px;
      margin-bottom: 13px;
      border: solid 1px;
      background: rgba(22, 197, 130, 0.10);
      color: #16C582;
    }

    .visitWebsite {
      padding: 5px 13px;
      font-size: 13px;
      font-weight: 500;
      border-radius: 10px;
      margin-bottom: 13px;
      border: solid 1px;
      text-decoration: none;
    }
     body {
            /* font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; */
            background: #fff;
            color: #111;
            font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif !important;
            overflow-x: hidden;
            margin: 0;

        }

        h1,
        h2,
        h3,
        p,
        span {
            font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif !important;

        }




        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 48px;
            border-bottom: 1px solid #eee;
        }

        .logo {
            display: flex;
            align-items: center;
            font-size: 32px;
            font-weight: bold;
            color: #111;
            margin: 0px !important;
        }

        .logo span {
            background: #0b74de;
            color: #fff;
            border-radius: 50%;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            font-size: 20px;
        }

        nav {
            display: flex;
            align-items: center;
            white-space: nowrap;
        }

        nav a {
            margin: 0 10px;
            text-decoration: none;
            color: #111;
            font-weight: 500;
            position: relative;
        }

        nav a:hover {
            color: #0b74de;
        }

        .dropdown {
            position: relative;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            min-width: 200px;
            z-index: 10;
            padding: 10px 0;
        }

        .dropdown-content a {
            display: block;
            padding: 10px 15px;
            color: #111;
            font-weight: 400;
            font-size: 14px;
            text-decoration: none;
        }

        .dropdown-content a:hover {
            background: #fafafa;
            color: #0b74de;
        }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        .download-btn {
            background: #0b74de;
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
        }
  </style>

</head>

<body>

  <!-- header start -->

  <%- include("../../partials/frountHeader.ejs")%>
    <!-- header end -->


    <section>
      <div class="container">
        <div class="col-md-8">
          <div class="breadcrumb">
            <a href="/" style="color: #555;">Home </a> ><a href="/eventListing" style="color: #555;">Events </a> > <a
              href="#">
              <%=eventListingData.title%>
            </a>
          </div>
          <button class="seminar">
            <%=eventListingData.eventType%>
          </button>

          <h2>
            <%=eventListingData.title%>
          </h2>
          <div style="margin: 13px 0px;color: #605e5e;" class="card-info">📍 <%=eventListingData.location%>
          </div>
          <div class="card-info">📅 <%=eventListingData.startDateFormatted%> – <%=eventListingData.endDateFormatted%>
          </div>
          <button class="seminar mt-3">
            <%=eventListingData.eventType%>
          </button>
          <a href="<%=eventListingData.website%>" target="_blank" class="visitWebsite">visit Website</a>
          <img style="width: 100%;" src="<%=eventListingData.bannerImage%>" alt="">

          <div class="event-description">
            <%- eventListingData.description %>
          </div>

        </div>
        <div class="col-md-4">

        </div>

      </div>

    </section>




</body>

</html>