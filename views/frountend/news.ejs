      color: #fff;
      font-weight: 500;
      min-width: 40px;
      text-align: center;
      transition: all 0.2s;
      background: #2878d3;
    }

    .page-box:hover:not(.active):not(.disabled) {
      background-color: #f0f0f0;
    }

    .page-box.active {
      color: #fff;
      font-weight: 600;
    }

    .page-box.disabled {
      color: #bbb;
      background-color: #f5f5f5;
      cursor: not-allowed;
    }

    .page-box.dots {
