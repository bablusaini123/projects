    .card-container {
      display: flex;
      flex-wrap: wrap;

      gap: 33px;
      justify-content: start;
    }

    .card {
      background-color: #fff;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      width: 100%;
      transition: transform 0.2s;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      max-width: 23%;
    }

    .card:hover {
      transform: translateY(-5px);
    }

    .card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .card-body {
      padding: 15px 8px;
    }

    .tags {
      display: flex;
      gap: 10px;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }

    .tag {
