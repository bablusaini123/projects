      font-size: 12px;
      background: #e0f7e9;
      color: #2e7d32;
    }

    .tag.crypto {
      background: #e3f2fd;
      color: #1565c0;
    }

    .card-title {
      font-size: 18px;
      font-weight: bold;
      margin: 5px 0 10px;
    }

    .card-info {
      font-size: 14px;
      color: #555;
      margin-bottom: 10px;
    }

    .card-footer {
