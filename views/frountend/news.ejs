      justify-content: space-between;
      align-items: center;
      font-size: 14px;
    }

    .link {
      text-decoration: none;
      color: #1e88e5;
      font-weight: 500;
    }

    @media (min-width: 768px) {
      .card {
        flex: 1 1 calc(50% - 20px);
      }
    }

    @media (min-width: 1024px) {
      .card {
        flex: 1 1 calc(25% - 20px);
      }
    }

