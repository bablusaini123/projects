      .right-div {
        display: none;
      }

      .breadcrumb {
        display: none;
      }

      .tab {
        padding: 4px 10px !important;
      }

      .eventBtn {
        padding: 8px 25px;
        background: #655de6;
        margin-left: auto;
        color: #fff;
        text-decoration: none;
        border-radius: 18px;
        font-weight: 600;
        font-size: 12px;
      }
          .logo a img {
        width: 70% !important;
        max-width: unset;
    }
    .footer-link{
      font-size: 14px !important;
    }

    }

    @media screen and (max-width: 480px) {
      .category-grid {
        grid-template-columns: 1fr;
      }
    }

    .truncate-text {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      display: block;
    }
  </style>
</head>

<body>

  <!-- header start -->

  <%- include("../../partials/frountHeader.ejs")%>
    <!-- header end -->

    <section>
      <div class="container">
        <div class="breadcrumb">
          <a href="/" style="color: #555;">Home</a> > <a href="/news"> News</a> > <span>
            <%=selectedCategory%>
          </span>
        </div>

        <div class="container">
          <div class="tabs">
            <div class="tab active">
              <%=selectedCategory%>
            </div>


            <!-- <div class="tab">Organizers</div>
            <div class="tab">Speakers</div> -->
            <a href="/addNews" class="eventBtn">News</a>
          </div>
        </div>

    </section>


    <section class="listingSection">
      <div class="container">

        <div class="row">
          <div class="col-md-9">
            <% newsData.forEach((result,index)=>{ %>
              <a href="/news/<%=result.slug%>"
                style="text-decoration: none;color: unset;margin-bottom: 11px;display: inline-block;width: 100%;">
                <div class="card" style="max-width: unset;flex-direction: unset;background: #f0f0f0;">
                  <div style="width: 34%;">
                    <img src="<%=result.newsBanner%>" class="card-img-top" alt="...">
                  </div>
                  <div class="card-body" style="width: 66%;padding-left: 17px;">
                    <h2 class="card-title truncate-text" style="font-size: 19px;">
                      <%=result.title%>
                    </h2>
                    <p class="card-text truncate-text" style="color: #575757;"><%-result.shortDescription%></p>
                    <div class="tegsDiv">
                      <% result.tags.slice(0, 3).forEach((result2,index)=>{ %>
                        <span class="tegSpan" style="padding: 4px 12px;
    background: #e7e5e5;
    text-align: center;
    border-radius: 10px;color: #575757;margin-left: 5px;">
                          <%=result2%>
                        </span>
                        <% })%>
                          <span style="float: right;margin-right: 10px;color: #575757;">
                            <%=result.publishDate%>
                          </span>

                    </div>
                  </div>
                </div>
              </a>
              <% })%>
          </div>
          <div class="col-md-3 right-div">

            <% newsData.forEach((result,index)=>{ %>
              <a href="/news/<%=result.slug%>"
                style="text-decoration: none;color: unset;margin-bottom: 11px;display: inline-block;width: 100%;border-radius: 10px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);    background: #dddada;">
                <div class="" style="max-width: unset;flex-direction: unset;display: unset;">
                  <div style="width: 100%;">
                    <img style="border-radius: 10px;" src="<%=result.newsBanner%>" class="card-img-top" alt="...">
                  </div>
                  <div class="card-body" style="width: 100%;padding-left: 17px;">
                    <h2 class="card-title" style="font-size: 19px;">
                      <%=result.title%>
                    </h2>

                  </div>
                </div>
              </a>
              <% })%>

          </div>
        </div>

        <section style="margin-left: auto;">
          <div class="pagination-container">
            <% if (current> 1) { %>
              <a href="/news?page=<%= current - 1 %>&category=<%= selectedCategory %>" class="page-box">‹</a>
              <% } else { %>
                <span class="page-box disabled">‹</span>
                <% } %>

                  <% if (current> 2) { %>
                    <a href="/news?page=1&category=<%= selectedCategory %>" class="page-box">1</a>
                    <% } %>

                      <% if (current> 3) { %>
                        <span class="page-box dots">...</span>
                        <% } %>

                          <% for (let i=current - 1; i <=current + 1; i++) { if (i> 1 && i < pages) { %>
                              <a href="/news?page=<%= i %>&category=<%= selectedCategory %>"
                                class="page-box <%= current === i ? 'active' : '' %>">
                                <%= i %>
                              </a>
                              <% } } %>

                                <% if (current < pages - 2) { %>
                                  <span class="page-box dots">...</span>
                                  <% } %>

                                    <% if (current < pages - 1) { %>
                                      <a href="/news?page=<%= pages %>&category=<%= selectedCategory %>"
                                        class="page-box">
                                        <%= pages %>
                                      </a>
                                      <% } %>

                                        <% if (current < pages) { %>
                                          <a href="/news?page=<%= current + 1 %>&category=<%= selectedCategory %>"
                                            class="page-box">›</a>
                                          <% } else { %>
                                            <span class="page-box disabled">›</span>
                                            <% } %>
          </div>

        </section>

      </div>

    </section>




    <%- include("../../partials/frountFooter.ejs")%>





      <script>
        function toggleMenu() {
          const nav = document.getElementById('nav');
          nav.classList.toggle('show');
        }
      </script>


      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>

      <script>
        // Hamburger Menu Toggle (for opening and closing the nav)
        // Hamburger menu click (for opening the sidebar)
        document.getElementById('hamburger-menu').addEventListener('click', function () {
          document.getElementById('sidebar').classList.add('active');
        });

        // Close button click (for closing the sidebar)
        document.getElementById('close-btn').addEventListener('click', function () {
          document.getElementById('sidebar').classList.remove('active');
        });


      </script>

</body>

</html>