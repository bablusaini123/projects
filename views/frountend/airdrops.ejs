<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700&family=DM+Sans:wght@400;500&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<title>Latest Crypto Airdrops 2025, Free Token Giveaways | KryptoDesk</title>
<meta name="description" content="Explore upcoming and ongoing crypto airdrops from top blockchain projects. Get step-by-step guides, rewards info, and participation links at KryptoDesk.">


  <script>
    const encodedData = '<%- Buffer.from(JSON.stringify(formattedAirdropListingData || [])).toString("base64") %>';
    const formattedAirdropData = JSON.parse(atob(encodedData));

    const structuredAirdrops = formattedAirdropData.map((airdrop, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Event",
        "name": airdrop.tokenName || "airdrop",
        "startDate": airdrop.startDate || new Date().toISOString(),
        "endDate": airdrop.endDate || new Date(new Date().getTime() + 7 * 24 * 60 * 60 * 1000).toISOString(), // 7 days from now fallback
        "eventStatus": "https://schema.org/EventScheduled",
        "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
        "description": airdrop.projectDescription
          ? airdrop.projectDescription.replace(/(<([^>]+)>)/gi, "").substring(0, 300)
          : "Participate in the latest crypto airdrop with detailed steps and rewards.",
        "url": `https://kryptodesk.com/airdrops/${airdrop.slug}`,
        "image": [
          airdrop.tokenImage || "https://kryptodesk.com/image/kryptodesk-logo.png",
          airdrop.bannerImage || "https://kryptodesk.com/image/kryptodesk-logo.png"
        ],
        "location": {
          "@type": "VirtualLocation",
          "url": `https://kryptodesk.com/airdrops/${airdrop.slug}`,
        },
        "organizer": {
          "@type": "Organization",
          "name": "KryptoDesk",
          "url": "https://kryptodesk.com",
          "email": "support@kryptodesk.com"
        },
        "offers": {
          "@type": "Offer",
          "url": `https://kryptodesk.com/airdrops/${airdrop.slug}`,
          "price": 1,  // Free airdrops ka price 0 hona chahiye
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock"
        },
        "performer": {
          "@type": "Person",
          "name": airdrop.authorName || "KryptoDesk"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.5",
          "reviewCount": "24"
        }
      }
    }));

    const jsonLd = {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Latest Crypto Airdrops",
      "description": "Find the latest crypto airdrops with detailed instructions, rewards, and project info at KryptoDesk.",
      "url": window.location.href,
      "itemListElement": structuredAirdrops
    };

    const scriptTag = document.createElement("script");
    scriptTag.type = "application/ld+json";
    scriptTag.text = JSON.stringify(jsonLd);
    document.head.appendChild(scriptTag);
  </script>


  <style>
    * {
      box-sizing: border-box;
    }


    .card-container {
      display: flex;
      flex-wrap: wrap;

      gap: 33px;
      justify-content: start;
    }

    .card {
      background-color: #fff;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      width: 100%;
      transition: transform 0.2s;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      max-width: 23%;
    }

    .card:hover {
      transform: translateY(-5px);
    }

    .card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .card-body {
      padding: 15px 8px;
    }

    .tags {
      display: flex;
      gap: 10px;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }

    .tag {
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 12px;
      background: #e0f7e9;
      color: #2e7d32;
    }

    .tag.crypto {
      background: #e3f2fd;
      color: #1565c0;
    }

    .card-title {
      font-size: 18px;
      font-weight: bold;
      margin: 5px 0 10px;
    }

    .card-info {
      font-size: 14px;
      color: #555;
      margin-bottom: 10px;
    }

    .card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
    }

    .link {
      text-decoration: none;
      color: #1e88e5;
      font-weight: 500;
    }

    @media (min-width: 768px) {
      .card {
        flex: 1 1 calc(50% - 20px);
      }
    }

    @media (min-width: 1024px) {
      .card {
        flex: 1 1 calc(25% - 20px);
      }
    }

    .listingSection {
      margin-top: 30px;
    }

    .breadcrumb {
      font-size: 14px;
      margin: 22px 0px;
      letter-spacing: 1px;
      color: #555;
    }

    .breadcrumb a {
      color: #1a73e8;
      text-decoration: none;
    }

    .tabs {
      display: flex;
      border-bottom: 1px solid #ddd;
      margin-bottom: 20px;
    }

    .tab {
      padding: 10px 20px;
      cursor: pointer;
      font-weight: 500;
      color: #333;
      border-bottom: 3px solid transparent;
      transition: border-bottom 0.3s;
    }

    .tab.active {
      border-bottom: 3px solid #1a73e8;
      color: #1a73e8;
      background: #eef4ff;
      border-top-left-radius: 5px;
      border-top-right-radius: 5px;
    }

    .filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      justify-content: space-between;
    }

    .filter-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    .filter-button,
    .reset-link {
      padding: 8px 12px;
      border: 1px solid #ddd;
      border-radius: 20px;
      background: #fff;
      font-size: 14px;
      cursor: pointer;
    }

    .filter-button:hover,
    .dropdown:hover,
    .reset-link:hover {
      background: #f0f0f0;
      color: black;
      transition: 0.7s;

    }

    .reset-link {
      color: #1a73e8;
      border: none;
      background: none;
      text-decoration: underline;
    }

    .create-search {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-top: 10px;
    }

    .create-btn {
      background-color: #0061ff;
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      cursor: pointer;
    }

    .search-box {
      display: flex;
      align-items: center;
      border: 1px solid #ddd;
      border-radius: 20px;
      padding: 8px 12px;
      background: white;
    }

    .search-box input {
      border: none;
      outline: none;
      font-size: 14px;
      padding-left: 8px;
    }

    .search-box svg {
      color: #888;
    }

    @media (max-width: 768px) {
      .filters {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }

      .create-search {
        flex-direction: column;
        align-items: flex-start;
        width: 100%;
      }

      .search-box {
        width: 100%;
      }
    }

    .eventBtn {
      padding: 10px 29px;
      background: #655de6;
      margin-left: auto;
      color: #fff;
      text-decoration: none;
      border-radius: 18px;
      font-weight: 600;
    }

    .eventBtn:hover {
      color: #fff;
    }

    .pagination-container {
      display: flex;
      justify-content: end;
      align-items: center;
      gap: 8px;
      margin-top: 20px;
    }

    .page-box {
      padding: 8px 12px;
      border: 1px solid #ccc;
      border-radius: 6px;
      text-decoration: none;
      color: #fff;
      font-weight: 500;
      min-width: 40px;
      text-align: center;
      transition: all 0.2s;
      background: #2878d3;
    }

    .page-box:hover:not(.active):not(.disabled) {
      background-color: #f0f0f0;
    }

    .page-box.active {
      color: #fff;
      font-weight: 600;
    }

    .page-box.disabled {
      color: #bbb;
      background-color: #f5f5f5;
      cursor: not-allowed;
    }

    .page-box.dots {
      pointer-events: none;
      border: none;
      background: transparent;
      color: #000;

    }

    button.active-btn {
      background: #4f46e5;
      color: white;
      padding: 8px 14px;
      border-radius: 6px;
      margin: 0 5px;
      text-decoration: none;
      border-radius: 20px;
    }

    .ongoingTeg {
      background: rgba(22, 197, 130, 0.10);
      color: #16C582;

    }

    .upcomingTeg {
      background: rgba(253, 126, 20, 0.10);
      color: #FD7E14;
    }

    .endTeg {
      color: #ff0000;
      background: rgba(224, 36, 61, 0.10);
    }

    .truncate-text {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      display: block;
    }

    .blockchain-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 6px;
    }

    .badge {
      font-size: 11px;
      padding: 4px 8px;
      border-radius: 12px;
      background-color: #d6d6d6;
      color: #333;
    }

    .badge.light {
      background-color: #ffe9ba;
      color: #9c6b00;
    }

    body {
      /* font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; */
      background: #fff;
      color: #111;
      font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif !important;
      overflow-x: hidden;
      margin: 0;

    }

    h1,
    h2,
    h3,
    p,
    span {
      font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif !important;

    }




    /* Main header styling */
        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 48px;
            border-bottom: 1px solid #eee;
            flex-wrap: wrap;
            /* Wrapping to allow proper stacking in mobile view */
        }

        .logo {
            display: flex;
            align-items: center;
            font-size: 32px;
            font-weight: bold;
            color: #111;
        }

        .hamburger-menu {
            display: none;
            cursor: pointer;
            font-size: 30px;
        }

        /* Normal desktop navigation */
        nav {
            display: flex;
            align-items: center;
            flex-grow: 1;
            white-space: nowrap;
            justify-content: center;
        }

        nav a {
            margin: 0 10px;
            text-decoration: none;
            color: #111;
            font-weight: 500;
        }

        nav a:hover {
            color: #0b74de;
        }

        .dropdown {
            position: relative;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 8px;
            padding: 10px 0;
            z-index: 10;
        }

        .dropdown-content a {
            display: block;
            padding: 10px 15px;
            color: #111;
        }

        .dropdown-content a:hover {
            background: #fafafa;
            color: #0b74de;
        }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        /* Sidebar Styling */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 90%;
            height: 100%;
            background: #fff;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
            transform: translateX(-100%);
            /* Sidebar hidden off-screen initially */
            transition: transform 0.5s ease;
            /* Smooth slide-in transition */
        }

        /* Active state (when sidebar is open) */
        .sidebar.active {
            transform: translateX(0);
            /* Slide-in to the left side */
        }

        .sidebar-logo {

            padding: 20px 12px;

        }

        .sidebar-logo img {
            width: 65% !important;
        }

        .close-btn {
            font-size: 30px;
            color: #111;
            position: absolute;
            top: 20px;
            right: 20px;
            cursor: pointer;
        }


        /* Media Query for Mobile (Less than or equal to 768px) */
        @media (max-width: 768px) {

            /* Display the hamburger menu for mobile */
            .hamburger-menu {
                display: block;
            }

            /* Hide the normal desktop navigation */
            nav {
                display: none;
            }

            /* Sidebar active on mobile */
            .sidebar.active {
                display: block;
            }

            .logo a img {
                width: 85% !important;
            }

            header {
                align-items: unset !important;
                flex-wrap: unset !important;
                padding: 15px 14px;
                flex-direction: unset;
                border: 1px solid #eee;
            }

            .hamburger-menu {
                font-size: 24px;
            }

            .logo {
                margin-bottom: 0;
            }

            .dropdown {
                background: #f6f6f6;
            }

        }

        .dropdown {
            position: relative;
            /* color: #000; */
            padding: 8px 10px;

            margin-bottom: 11px;
        }

        .dropdown a {
            text-decoration: none;
            color: #000;
        }

       
  </style>
</head>

<body>

  <!-- header start -->

  <%- include("../../partials/frountHeader.ejs")%>
    <!-- header end -->

    <section>
      <div class="container">
        <div class="breadcrumb">
          <a href="/" style="color: #555;">Home</a> > <a href="#"> Airdrops</a>
        </div>

        <div class="container">
          <div class="tabs">
            <div class="tab active">All Airdrops Listing</div>
            <!-- <div class="tab">Organizers</div>
            <div class="tab">Speakers</div> -->
            <a href="/createAirdrop" class="eventBtn">List Airdrop</a>
          </div>
        </div>



        <h2>All Airdrops Listing</h2>

        <div class="filters">
          <div class="filter-group">
            <a href="/Airdrops?page=1&category=ongoing" class=""> <button
                class="filter-button <%= selectedCategory == 'ongoing' ? 'active-btn' : '' %>">Ongoing</button> </a>
            <a href="/Airdrops?page=1&category=upcoming" class=""><button
                class="filter-button <%= selectedCategory == 'upcoming' ? 'active-btn' : '' %>"> Upcoming</button> </a>
            <a href="/Airdrops?page=1&category=ended" class=""> <button
                class="filter-button <%= selectedCategory == 'ended' ? 'active-btn' : '' %>">Ended</button></a>
            <a href="/Airdrops?page=1" class=""> <button
                class="filter-button <%= selectedCategory === 'all' ? 'active-btn' : '' %>">All</button> </a>
            <!-- <select class="dropdown">
              <option>All locations</option>
              <option>Osaka</option>
              <option>New York</option>
            </select>

            <select class="dropdown">
              <option>Date</option>
              <option>Today</option>
              <option>This Week</option>
            </select>

            <select class="dropdown">
              <option>Price</option>
