<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= icoData.title %> - ICO Details</title>

    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "<%= icoData.title %>",
  "description": "Explore the details of the ICO for <%= icoData.title %>. Find out about the tokenomics, roadmap, and investment opportunities.",
  "brand": {
    "@type": "Organization",
    "name": "<%= icoData.title %>"
  },
  "releaseDate": "<%= icoData.startDate %>",
  "url": "https://kryptodesk.com/ico/<%= icoData.slug %>",
  "offers": {
    "@type": "Offer",
    "priceCurrency": "USD",
    "price": "<%= icoData.totalRaise %>",
    "availability": "https://schema.org/PreOrder"
  }
}
</script>
    <link <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #ffffff;
            color: #000000;
            line-height: 1.5;
        }

        .banner {
            background: linear-gradient(135deg, #007bff, #0056b3);
            color: white;
            padding: 8px 0;
            text-align: center;
            font-size: 12px;
            font-weight: 500;
        }



        .lang-btn,
        .partnership-btn {
            padding: 8px 16px;
            border: 1px solid #ddd;
            background: white;
            border-radius: 6px;
            text-decoration: none;
            color: #333;
            font-size: 13px;
            font-weight: 500;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 30px 0px;
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 30px;
        }

        .main-content {
            background: white;
            border: 1px solid #e5e5e5;
            border-radius: 12px;
            padding: 32px;
        }

        .breadcrumb {
            color: #666;
            font-size: 14px;
            margin-bottom: 24px;
        }

        .breadcrumb a {
            color: #666;
            text-decoration: none;
        }

        .project-header {
            display: flex;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 28px;
        }

        .project-logo {
            width: 70px;
            height: 66px;
            background: linear-gradient(135deg, #00c851, #007e33);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 24px;
            flex-shrink: 0;
            border-radius: 20px;
            overflow: hidden;
        }

        .project-logo img {
            width: 100%;
        }

        .project-title {
            flex: 1;
        }

        .project-title h1 {
            font-size: 36px;
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 0;
            color: #000;
        }

        .join-btn {
            background: #ff4757;
            color: white;
            padding: 12px 28px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            margin-top: 8px;
        }

        .project-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 32px;
            font-size: 13px;
        }

        .meta-date {
            color: #666;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .meta-date::before {
            content: "📅";
        }

        .status-badge {
            padding: 4px 10px;
            border-radius: 16px;
            font-size: 12px;
            font-weight: 600;
            border: none;
        }

        .easy {
            background: #e8f5e8;
            color: #2d5a2d;
        }

        .high-reward {
            background: #fff8e1;
            color: #8b6914;
        }

        .high-reward::before {
            content: "🏆 ";
        }

        .hot {
            background: #ffeaa7;
            color: #d35400;
        }

        .epic {
            background: #f0f0f0;
            color: #2c3e50;
        }

        .limited {
            background: #e8f8f5;
            color: #00695c;
        }

        .description {
            margin-bottom: 28px;
            line-height: 1.6;
            color: #333;
        }

        .description p {
            margin-bottom: 16px;
        }

        .features {
            margin: 24px 0;
        }

        .features ul {
            list-style: none;
            padding-left: 0;
        }

        .features li {
            margin-bottom: 8px;
            padding-left: 20px;
            position: relative;
            color: #333;
        }

        .features li::before {
            content: "•";
            color: #00c851;
            font-weight: bold;
            position: absolute;
            left: 0;
        }

        .link-section {
            margin-bottom: 32px;
            color: #333;
        }

        .link-section p {
            margin-bottom: 16px;
        }

        .link-text {
            color: #007bff;
            text-decoration: underline;
            cursor: pointer;
        }

        .project-info {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 20px;
            margin: 32px 0;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .info-row:last-child {
            margin-bottom: 0;
        }

        .info-label {
            color: #666;
            font-weight: 500;
        }

        .info-value {
            color: #333;
            font-weight: 600;
        }

        .overview-section {
            border-top: 2px solid #e5e5e5;
            padding-top: 32px;
            margin-top: 32px;
        }

        .overview-section h2 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 24px;
            color: #000;
            background: #f8f8f8;
            border: 1px solid #e9ecef;
            padding: 11px 10px;
            border-radius: 18px;
        }

        .overview-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0;
        }

        .overview-item {
            display: flex;
            justify-content: space-between;
            padding: 10px 18px;
            border-bottom: 1px solid #f0f0f0;
            width: 49%;
            background: #f4f4f4;
            border-radius: 20px;
            margin-bottom: 12px;

        }

        .overview-item2 {
            display: flex;
            justify-content: space-between;
            padding: 10px 18px;
            border-bottom: 1px solid #f0f0f0;
            width: 49%;
            background: #fff;
            border-radius: 20px;
            margin-bottom: 12px;

        }

        .overviewMain {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;

        }

        .overviewMain2 {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            background: #ececec;
            padding: 14px;
            border-radius: 20px;

        }

        .sidebar {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .sidebar-card {
            background: white;
            border: 1px solid #e5e5e5;
            border-radius: 12px;
            padding: 24px;
        }

        .sidebar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            font-weight: 600;
        }

        .report-issue {
            color: #ff6b35;
            font-size: 13px;
            cursor: pointer;
        }

        .report-issue::before {
            content: "⚠️ ";
        }

        .difficulty-section h4 {
            margin-bottom: 12px;
            font-size: 16px;
            font-weight: 600;
            color: #000;
        }

        .difficulty-badge {
            background: #e8f5e8;
            color: #2d5a2d;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
        }

        .countdown-card {
            text-align: center;
        }

        .countdown-timer {
            font-size: 28px;
            font-weight: bold;
            color: #333;
            margin-bottom: 8px;
            font-family: 'Courier New', monospace;
        }

        .countdown-label {
            font-size: 12px;
            color: #666;
            margin-bottom: 24px;
        }

        .more-about {
            font-weight: 600;
            margin-bottom: 20px;
            color: #000;
        }

        .social-buttons {
            display: flex;
            justify-content: center;
            gap: 8px;
        }

        .social-btn {
            width: 44px;
            height: 44px;
            border: 1px solid #ddd;
            background: white;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #666;
            text-decoration: none;
            font-size: 18px;
            transition: all 0.2s;
        }

        .social-btn:hover {
            background: #f5f5f5;
            border-color: #bbb;
        }

        @media (max-width: 768px) {
            .container {
                grid-template-columns: 1fr;
                gap: 20px;
                padding: 20px;
            }

            .nav-links {
                display: none;
            }

            .project-header {
                flex-direction: column;
                text-align: center;
            }

            .project-meta {
                justify-content: center;
            }

            .overview-grid {
                grid-template-columns: 1fr;
            }

        }

        body {
            /* font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; */
            background: #fff;
            color: #111;
            font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif !important;
            overflow-x: hidden;
            margin: 0;

        }

        h1,
        h2,
        h3,
        p,
        span {
            font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif !important;

        }




        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 48px;
            border-bottom: 1px solid #eee;
        }

        .logo {
            display: flex;
            align-items: center;
            font-size: 32px;
            font-weight: bold;
            color: #111;
            margin: 0px !important;
        }

        .logo span {
            background: #0b74de;
            color: #fff;
            border-radius: 50%;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            font-size: 20px;
        }

        nav {
            display: flex;
            align-items: center;
            white-space: nowrap;
        }

        nav a {
            margin: 0 10px;
            text-decoration: none;
            color: #111;
            font-weight: 500;
            position: relative;
        }

        nav a:hover {
            color: #0b74de;
        }

        .dropdown {
            position: relative;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            min-width: 200px;
            z-index: 10;
            padding: 10px 0;
        }

        .dropdown-content a {
            display: block;
            padding: 10px 15px;
            color: #111;
            font-weight: 400;
            font-size: 14px;
            text-decoration: none;
        }

        .dropdown-content a:hover {
            background: #fafafa;
            color: #0b74de;
        }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        .download-btn {
            background: #0b74de;
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
        }

        .truncate-text {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
        }

        .blockchain-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;

        }

        .badge {
            font-size: 11px;
            padding: 4px 8px;
            border-radius: 12px;
            background-color: #d6d6d6;
            color: #333;
        }

        .badge.light {
            background-color: #ffe9ba;
            color: #9c6b00;
        }

        .team-section {
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title {
            font-size: 48px;
            font-weight: 700;
            color: #333;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .team-member {
            text-align: center;
        }

        .member-image-container {
            position: relative;
            width: 100%;

            overflow: hidden;
            margin-bottom: 15px;
            cursor: pointer;
        }

        .member-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: all 0.3s ease;
        }

        .member-image-container:hover .member-image {
            filter: blur(3px);
            transform: scale(1.1);
        }

        .social-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.3s ease;
        }

        .member-image-container:hover .social-overlay {
            opacity: 1;
            transform: translateY(0);
        }

        .social-icon {
            width: 35px;
            height: 35px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 20px;
            transition: all 0.3s ease;
            transform: scale(0.8);
        }

        .member-image-container:hover .social-icon {
            transform: scale(1);
        }

        .social-icon:hover {
            transform: scale(1.2) !important;
        }

        .facebook {
            color: #1877f2;
        }

        .facebook:hover {
            background: #1877f2;
            color: white;
        }

        .twitter {
            color: #1da1f2;
        }

        .twitter:hover {
            background: #1da1f2;
            color: white;
        }

        .instagram {
            color: #e4405f;
        }

        .instagram:hover {
            background: #e4405f;
            color: white;
        }

        .linkedin {
            color: #0077b5;
        }

        .linkedin:hover {
            background: #0077b5;
            color: white;
        }

        .youtube {
            color: #ff0000;
        }

        .youtube:hover {
            background: #ff0000;
            color: white;
        }

        .member-name {
            font-size: 20px;
            font-weight: 600;
            color: #333;
        }

        /* Responsive Design */
        @media (max-width: 1024px) {
            .team-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 25px;
            }
        }

        @media (max-width: 768px) {
            .team-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }

            .section-title {
                font-size: 36px;
            }

            .member-image-container {
                height: 250px;
            }
        }

        @media (max-width: 480px) {
            .team-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .section-title {
                font-size: 28px;
            }

            .member-image-container {
                height: 300px;
            }
        }
    </style>
</head>

<body>
    <!-- header start -->

    <%- include("../../partials/frountHeader.ejs")%>
        <!-- header end -->

        <div class="container">
            <main class="main-content">
                <div class="breadcrumb">
                    <a href="/">Home</a> / <a href="/icoListing">ICO Listing</a> / <%=icoData.title%> • Waitlist
                </div>

                <div class="project-header">
                    <div class="project-logo">
                        <img src="<%=icoData.logo%>" alt="">
                    </div>
                    <div class="project-title">
                        <h1>
                            <%=icoData.title%>
                        </h1>
                    </div>
                    <a href="#" class="join-btn">Join</a>
                </div>

                <div class="project-meta">
                    <div class="meta-date">
                        <%=icoData.formattedStartDate%> - <%=icoData.formattendDate%>
                    </div>
                    <span class="status-badge easy">Easy</span>
                    <span class="status-badge high-reward">High Reward</span>
                    <span class="status-badge hot">Hot</span>
                    <span class="status-badge epic">Epic</span>
                    <span class="status-badge limited">Limited</span>
                </div>

                <div class="description">
                    <%-icoData.smallDescription-%>
                </div>

                <div class="project-info">
                    <div class="info-row">
                        <span class="info-label">CoinLaunch Score:</span>
                        <span class="info-value">Very High</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Last update:</span>
                        <span class="info-value">07 Nov 2023</span>
                    </div>
                </div>

                <div class="overview-section">
                    <h2>
                        <%=icoData.title%> - WAITLIST Overview
                    </h2>
                    <div class="overviewMain">
                        <div class="overview-item">
                            <span class="info-label">Ticker:</span>
                            <span class="info-value">
                                <%=icoData.ticker%>
                            </span>
                        </div>

                        <div class="overview-item">
                            <span class="info-label">Start Date:</span>
                            <span class="info-value">
                                <%=icoData.formattedStartDate%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">End Date:</span>
                            <span class="info-value">
                                <%=icoData.formattedStartDate%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Country:</span>
                            <span class="info-value truncate-text">
                                <%=icoData.country%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Whitelist:</span>
                            <span class="info-value">
                                <%=icoData.whitelist%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">KYC:</span>
                            <span class="info-value">
                                <%=icoData.kyc%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Bounty:</span>
                            <span class="info-value">
                                <%=icoData.bounty%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">MVP:</span>
                            <span class="info-value">
                                <%=icoData.mvp%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Security Audit:</span>
                            <span class="info-value">
                                <%=icoData.securityAudit%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Raise Fund:</span>
                            <span class="info-value truncate-text">
                                <%=icoData.raiseFund%>
                            </span>
                        </div>

                        <div class="overview-item">
                            <span class="info-label truncate-text">Block Chain:</span>
                            <span class="info-value truncate-text" title="<%=icoData.initialCirculationSupply%>">
                                <div class="blockchain-tags">
                                    <% const maxVisible2=3; const blockChain=icoData.blockChain || []; const
                                        blockChainTag=blockChain.slice(0, maxVisible2); const
                                        remainingCount2=blockChain.length - blockChainTag.length; %>

                                        <% blockChainTag.forEach(tag=> { %>
                                            <span class="badge gray">
                                                <%= tag %>
                                            </span>
                                            <% }) %>

                                                <% if (remainingCount2> 0) { %>
                                                    <span class="badge light">+<%= remainingCount2 %></span>
                                                    <% } %>
                                </div>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label truncate-text">Industry:</span>
                            <span class="info-value truncate-text" title="<%=icoData.initialCirculationSupply%>">
                                <div class="blockchain-tags">
                                    <% const maxVisible=1; const industry=icoData.industry || []; const
                                        industryTag=industry.slice(0, maxVisible); const remainingCount=industry.length
                                        - industryTag.length; %>

                                        <% industryTag.forEach(tag=> { %>
                                            <span class="badge gray truncate-text">
                                                <%= tag %>
                                            </span>
                                            <% }) %>

                                                <% if (remainingCount> 0) { %>
                                                    <span class="badge light">+<%= remainingCount %></span>
                                                    <% } %>
                                </div>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="overview-section">
                    <h2>
                        <%=icoData.title%> - Review
                    </h2>
                    <div>
                        <%-icoData.tokenReview-%>
                    </div>

                </div>
                <div class="overview-section">
                    <h2>
                        <%=icoData.title%> - Token Economy
                    </h2>
                    <div class="overviewMain">

                        <div class="overview-item">
                            <span class="info-label">Total Raise:</span>
                            <span class="info-value truncate-text">
                                <%=icoData.totalRaise%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Pre Sale:</span>
                            <span class="info-value truncate-text">
                                <%=icoData.preSale%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">FDV:</span>
                            <span class="info-value truncate-text">
                                <%=icoData.fdv%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Total Supply:</span>
                            <span class="info-value truncate-text">
                                <%=icoData.totalSupply%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Public Sale:</span>
                            <span class="info-value truncate-text" title="<%=icoData.publicSale%>">
                                <%=icoData.publicSale%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label truncate-text">Initial Circulation Supply:</span>
                            <span class="info-value truncate-text" title="<%=icoData.initialCirculationSupply%>">
                                <%=icoData.initialCirculationSupply%>
                            </span>
                        </div>


                    </div>
                </div>

                <div class="overview-section">
                    <h2>
                        <%=icoData.title%> - Token Sale Rounds
                    </h2>
                    <% icoData.rounds?.forEach((result,index)=>{ %>
                        <div class="overviewMain2">
                            <div class="overview-item2">
                                <span class="info-label">Price:</span>
                                <span class="info-value truncate-text">
                                    <%=result.price%>
                                </span>
                            </div>
                            <div class="overview-item2">
                                <span class="info-label">Tokens for sale:</span>
                                <span class="info-value truncate-text">
                                    <%=result.tokenForSale%>
                                </span>
                            </div>
                            <div class="overview-item2">
                                <span class="info-label">Raise:</span>
                                <span class="info-value truncate-text">
                                    <%=result.raisePrice%>
                                </span>
                            </div>

                            <div class="overview-item2">
                                <span class="info-label" style="width: 39%;">Lock-Up:</span>
                                <span class="info-value truncate-text">
                                    <%=result.lookUp%>
                                </span>
                            </div>
                            <div class="overview-item2">
                                <span class="info-label">Start Date:</span>
                                <span class="info-value truncate-text">
                                    <% const start=new Date(result.startDate); const end=new Date(result.endtDate);
                                        const months=["Jan", "Feb" , "Mar" , "Apr" , "May" , "Jun" , "Jul" , "Aug"
                                        , "Sep" , "Oct" , "Nov" , "Dec" ]; const formatDate=(date)=> {
                                        const day = date.getDate().toString().padStart(2, '0');
                                        const month = months[date.getMonth()];
                                        const year = date.getFullYear();
                                        return `${day} ${month} ${year}`;
                                        };

                                        const formattedStartDate = formatDate(start);
                                        const formattedEndDate = formatDate(end);
                                        %>

                                        <p>
                                            <%= formattedStartDate %>
                                        </p>

                                </span>
                            </div>

                            <div class="overview-item2">
                                <span class="info-label">End Date:</span>
                                <span class="info-value truncate-text">
                                    <p>
                                        <%= formattedEndDate %>
                                    </p>
                                </span>
                            </div>
                        </div>
                        <% })%>
                </div>

                <div class="overview-section">
                    <h2>
                        <%=icoData.title%> - Team
                    </h2>

                    <div class="team-section">
                        <div class="team-grid">

                            <% icoData.teams?.forEach((result,index)=>{ %>
                                <div class="team-member">
                                    <div class="member-image-container">
                                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop&crop=face"
                                            alt="Rahul Sharma" class="member-image">
                                        <div class="social-overlay">
                                            <a target="_blank" href="<%=result.twitter%>"
                                                class="social-icon facebook"><i class="fa fa-twitter"
                                                    aria-hidden="true"></i></a>
                                            <a target="_blank" href="<%=result.telegram%>"
                                                class="social-icon twitter"><i class="fa fa-telegram"
                                                    aria-hidden="true"></i></a>
                                            <a target="_blank" href="<%=result.website%>" class="social-icon twitter"><i
                                                    class="fa fa-globe" aria-hidden="true"></i></a>

                                        </div>
                                    </div>
                                    <h3 class="member-name">
                                        <%=result.name%>
                                    </h3>

                                </div>
                                <% })%>


                        </div>
                    </div>

            </main>

            <aside class="sidebar">
                <div class="sidebar-card">
                    <div class="sidebar-header">
                        <span>Waitlist</span>
                        <span class="report-issue">Report Issue</span>
                    </div>

                    <div class="difficulty-section">
                        <h4>Difficulty</h4>
                        <div class="difficulty-badge">Easy</div>
                    </div>
                </div>

                <div class="sidebar-card countdown-card">
                    <div class="countdown-timer">-518 : 09 : 13 : 49</div>
                    <div class="countdown-label">days - hours - min - sec</div>

                    <div class="more-about">More about goodcryptoX</div>

                    <div class="social-buttons">
                        <a href="#" class="social-btn">🔗</a>
                        <a href="#" class="social-btn">🐦</a>
                        <a href="#" class="social-btn">💬</a>
                        <a href="#" class="social-btn">📱</a>
                    </div>
                </div>
            </aside>
        </div>
</body>

</html>