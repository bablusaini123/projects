    <!-- Meta Title & Description for ICO Detail Page -->
    <!-- Open Graph Meta Tags for WhatsApp & Social Sharing -->
    <meta property="og:title" content="<%= icoData.title %>" />
    <meta property="og:description"
        content="Get complete details of the <%= icoData.title %> ICO including tokenomics, fundraising, roadmap, and team. Participate in the <%= icoData.title %> token sale on KryptoDesk." />
    <meta property="og:url" content="https://kryptodesk.com/ico/<%= icoData.slug %>" />
    <meta property="og:image" content="<%= icoData.logo || 'https://kryptodesk.com/image/kryptodesk-logo.png' %>" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KryptoDesk" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= icoData.title %>" />
    <meta name="twitter:description" content="🚀 New ICO Launched! Check us out on KryptoDesk!" />
    <meta name="twitter:image" content="<%= icoData.logo || 'https://kryptodesk.com/image/kryptodesk-logo.png' %>" />
    <title>
        <%= icoData.title %> ICO, Token Sale, Tokenomics, Team & Roadmap | KryptoDesk
    </title>
    <meta name="description"
        content="Get complete details of the <%= icoData.title %> ICO including tokenomics, fundraising, roadmap, and team. Participate in the <%= icoData.title %> token sale on KryptoDesk.">



    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "<%= icoData.title %> ICO",
  "description": "<%= icoData.description?.replace(/(<([^>]+)>)/gi, '').substring(0, 300) || 'Explore detailed information about this crypto ICO including tokenomics, roadmap, and team.' %>",
  "image": "<%= icoData.logo || 'https://kryptodesk.com/image/kryptodesk-logo.png' %>",
  "brand": {
    "@type": "Organization",
    "name": "<%= icoData.title %>"
  },
  "releaseDate": "<%= icoData.startDate %>",
  "url": "https://kryptodesk.com/ico/<%= icoData.slug %>",
  "offers": {
  "@type": "Offer",
  "priceCurrency": "USD",
  "price": "<%= icoData.rounds?.[0]?.price?.replace(/[^0-9.]/g, '') || '0.05' %>",
  "availability": "https://schema.org/PreOrder",
  "url": "https://kryptodesk.com/ico/<%= icoData.slug %>",
  "priceValidUntil": "<%= icoData.endDate || new Date(new Date().getTime() + 14 * 24 * 60 * 60 * 1000).toISOString().split('T')[0] %>"
},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": "24"
  }
}
</script>

