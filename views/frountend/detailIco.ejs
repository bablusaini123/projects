        }

        .privacy-link {
            color: #0b74de;
            text-decoration: none;
        }

        .privacy-link:hover {
            text-decoration: underline;
        }

        .footer-content {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-brand {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo-icon {
            width: 32px;
            height: 32px;
            background: #0b74de;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 14px;
        }

        .logo-text {
            font-size: 20px;
            font-weight: 700;
            color: #1e293b;
        }

        .social-links {
            display: flex;
            gap: 12px;
        }

        .social-link {
            width: 36px;
            height: 36px;
            background: #f1f5f9;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #64748b;
            text-decoration: none;
            transition: all 0.2s;
        }

        .social-link:hover {
            background: #0b74de;
            color: white;
        }

        .footer-column {
            display: flex;
            flex-direction: column;
        }

        .footer-title {
            font-size: 16px;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 20px;
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .footer-link {
            color: #64748b;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.2s;
        }

        .footer-link:hover {
            color: #0b74de;
        }

        .footer-bottom {
            padding-top: 30px;
            border-top: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .copyright {
            font-size: 14px;
            color: #0b74de;
        }

        .scroll-top {
            width: 40px;
            height: 40px;
            background: #0b74de;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-decoration: none;
            transition: background 0.2s;
        }

        .scroll-top:hover {
            background: #0b74de;
        }

        @media (max-width: 768px) {
            .footer-container {
                padding: 0 20px;
            }

            .newsletter-form {
                flex-direction: column;
                gap: 12px;
            }

            .email-input {
                border-radius: 8px;
                border-right: 1px solid #d1d5db;
            }

            .subscribe-btn {
                border-radius: 8px;
            }

            .footer-content {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .footer-bottom {
                flex-direction: column;
                gap: 20px;
                text-align: center;
            }

            /* Display the hamburger menu for mobile */
            .hamburger-menu {
                display: block;
            }

            /* Hide the normal desktop navigation */
            nav {
                display: none;
            }

            /* Sidebar active on mobile */
            .sidebar.active {
                display: block;
            }

            .logo a img {
                width: 85% !important;
            }

            header {
                align-items: unset !important;
                flex-wrap: unset !important;
                padding: 15px 14px;
                flex-direction: unset;
                border: 1px solid #eee;
            }

            .hamburger-menu {
                font-size: 24px;
            }

            .logo {
                margin-bottom: 0;
            }

            .dropdown {
                background: #f6f6f6;
            }

            .tab {
                padding: 6px 16px;
                font-weight: 600;
                font-size: 13px;
            }

            .eventBtn {
                padding: 0px 15px;
                background: #55b1ed;
                margin-left: auto;
                color: #000;
                text-decoration: none;
                border-radius: 18px;
                font-weight: 500;
                font-size: 11px;
                align-items: center;
                display: flex;
            }

            .card-container {
                flex-wrap: wrap;
            }

            .card {
                max-width: 100%;
            }

            .bitcoin-guides {
                margin: 0px 10px !important;
                gap: 0 !important;
            }

            .footer-bottom {
                padding-top: 0px;
            }

            .newsletter-section {
                margin-bottom: 17px !important;
                padding-bottom: 20px !important;
            }

            .newsletter-title {
                margin-top: 30px;
            }

            .filters {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .create-search {
                flex-direction: column;
                align-items: flex-start;
                width: 100%;
            }

            .search-box {
                width: 100%;
            }
        }

        .newsletter-title {
            margin-top: 30px;
            transition: transform 0.3s ease, color 0.3s ease;
        }

        .socialMediaIcon img {
            transition: transform 0.3s ease, color 0.3s ease;
        }

        .socialMediaIcon:hover.socialMediaIcon img {
            transform: scale(1.1);
        }

        .websiteBtn {
            transition: 0.2s;
        }

        .websiteBtn:hover {
            box-shadow: 0px 0px 8px 0px rgba(0, 0, 0, 0.4);

        }

        .overview-item3 {
            width: 100% !important;
        }
    </style>
</head>

<body>
    <!-- header start -->

    <%- include("../../partials/frountHeader.ejs")%>
        <!-- header end -->

        <div class="container">
            <main class="main-content">
                <div class="breadcrumb" style="align-items: center;display: flex;">
                    <a href="/">Home</a> / <a href="/ico">ICO Listing</a> / <%=icoData.title%> • Waitlist
                        <a target="_blank" href="<%=icoData.twitterLink%>" style="margin-left: auto"
                            class="socialMediaIcon">

                            <img style="width: 30px;" src="../../image/twitter.png" alt="">
                        </a>
                        <a target="_blank" href="<%=icoData.TelegramChannel%>" style="margin-left: 10px;"
                            class="socialMediaIcon">
                            <img style="width: 30px;" src="../../image/telegram.png" alt="">
                        </a>
                        <a target="_blank" href="<%=icoData.twitterLink%>" style="margin-left: 10px;"
                            class="socialMediaIcon">
                            <img style="width: 30px;" src="../../image/discord.png" alt="">
                        </a>
                        <a target="_blank" href="<%=icoData.twitterLink%>" style="margin-left: 10px;"
                            class="socialMediaIcon">
                            <img style="width: 30px;" src="../../image/facebook.png" alt="">
                        </a>
                        <a target="_blank" href="<%=icoData.youtubeLink%>" style="margin-left: 10px;"
                            class="socialMediaIcon">
                            <img style="width: 30px;" src="../../image/youtube.png" alt="">
                        </a>
                        <a target="_blank" href="<%=icoData.instagramLink%>" style="margin-left: 10px;"
                            class="socialMediaIcon">
                            <img style="width: 30px;" src="../../image/instagram.png" alt="">
                        </a>

                </div>

                <div class="project-header">
                    <div class="project-logo">
                        <img src="<%=icoData.logo%>" alt="<%=icoData.logoAltText%>">
                    </div>
                    <div class="project-title">
                        <h1>
                            <%=icoData.title%>
                        </h1>
                    </div>
                    <div class="meta-date">
                        <span style="padding: 8px 23px;
    background: #eeeeee;
    border-radius: 17px;
    color: #262626;
    /* font-size: 17px; */
    font-weight: 500;">
                            <%=icoData.formattedStartDate%>
                        </span> - <span style="padding: 8px 23px;
    background: #eeeeee;
    border-radius: 17px;
    color: #262626;
    /* font-size: 17px; */
    font-weight: 500;">
                            <%=icoData.formattendDate%>
                        </span>
                    </div>
                </div>

                <div class="project-meta">

                    <span class="status-badge easy">Easy</span>
                    <span class="status-badge high-reward">High Reward</span>
                    <span class="status-badge hot">Hot</span>
                    <span class="status-badge epic">Epic</span>
                    <span class="status-badge limited">Limited</span>
                    <a class="websiteBtn" target="_blank" href="<%=icoData.websiteLink%>" style="padding: 8px 16px;align-items: center;display: flex;
    background: #eeeeee;
    border-radius: 17px;
    color: #262626;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    margin-left: auto;">
                        <span style="margin-right: 8px;align-items: center;display: flex;">
                            <img style="width: 23px;" src="../../image/web.png" alt="">
                        </span>
                        <span>
                            Visit Website
                        </span>
                    </a>
                </div>

                <div class="description">
                    <%-icoData.smallDescription-%>
                </div>

                <div class="project-info">
                    <div class="info-row">
                        <span class="info-label">CoinLaunch Score:</span>
                        <span class="info-value">Very High</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Last update:</span>
                        <span class="info-value">07 Nov 2023</span>
                    </div>
                </div>

                <div class="overview-section">
                    <h2>
                        <%=icoData.title%> - WAITLIST Overview
                    </h2>
                    <div class="overviewMain">
                        <div class="overview-item">
                            <span class="info-label">Ticker:</span>
                            <span class="info-value">
                                <%=icoData.ticker%>
                            </span>
                        </div>

                        <div class="overview-item">
                            <span class="info-label">Start Date:</span>
                            <span class="info-value">
                                <%=icoData.formattedStartDate%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">End Date:</span>
                            <span class="info-value">
                                <%=icoData.formattedStartDate%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Country:</span>
                            <span class="info-value truncate-text">
                                <%=icoData.country%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Whitelist:</span>
                            <span class="info-value">
                                <%=icoData.whitelist%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">KYC:</span>
                            <span class="info-value">
                                <%=icoData.kyc%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Bounty:</span>
                            <span class="info-value">
                                <%=icoData.bounty%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">MVP:</span>
                            <span class="info-value">
                                <%=icoData.mvp%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Security Audit:</span>
                            <span class="info-value">
                                <%=icoData.securityAudit%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Raise Fund:</span>
                            <span class="info-value truncate-text">
                                <%=icoData.raiseFund%>
                            </span>
                        </div>


                    </div>
                </div>
                <div class="overview-section">
                    <h2>
                        <%=icoData.title%> - Review
                    </h2>
                    <div>
                        <%-icoData.tokenReview-%>
                    </div>

                </div>




                <div class="overview-section">
                    <h2>
                        <%=icoData.title%> - Team
                    </h2>

                    <div class="team-section">
                        <div class="team-grid">

                            <% icoData.teams?.forEach((result,index)=>{ %>
                                <div class="team-member">
                                    <div class="member-image-container">
                                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop&crop=face"
                                            alt="Rahul Sharma" class="member-image">
                                        <div class="social-overlay">
                                            <a target="_blank" href="<%=result.twitter%>"
                                                class="social-icon facebook"><i class="fa fa-twitter"
                                                    aria-hidden="true"></i></a>
                                            <a target="_blank" href="<%=result.telegram%>"
                                                class="social-icon twitter"><i class="fa fa-telegram"
                                                    aria-hidden="true"></i></a>
                                            <a target="_blank" href="<%=result.website%>" class="social-icon twitter"><i
                                                    class="fa fa-globe" aria-hidden="true"></i></a>

                                        </div>
                                    </div>
                                    <h3 class="member-name">
                                        <%=result.name%>
                                    </h3>

                                </div>
                                <% })%>


                        </div>
                    </div>
                </div>
                <div class="overview-section">
                    <h2>
                        RoadMap
                    </h2>

                    <div class="">
                        <div class="" style="text-align: center;">

                            <img style="width: 100%;" src="<%=icoData.roadmap%>" alt="<%=icoData.roadmapAltText%>">

                        </div>
                    </div>
                </div>

            </main>

            <div>
                <div class="overview-section">
                    <h2>
                        Tokenomics
                    </h2>
                    <% icoData.rounds?.slice(0, 1).forEach((result,index)=>{ %>
                        <div class="overviewMain2">
                            <a class="websiteBtn" target="_blank" href="" style="padding: 8px 16px;align-items: center;display: flex;
    background: #eeeeee;
    border-radius: 17px;
    color: #262626;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    margin: auto;
    border: solid 1px #fff;
    box-shadow: 0px 0px 8px 0px rgba(255,255,255,1);
    margin-bottom: 10px;;
">
                                <span>
                                    <img style="width: 25px; margin-right: 7px;" src="../../image/document.png"
                                        alt="<%=icoData.whitepaperAltText%>">
                                </span>
                                <span>
                                    WhitePaper
                                </span>
                            </a>
                            <div class="overview-item2 overview-item3">
                                <span class="info-label">Price:</span>
                                <span class="info-value truncate-text">
                                    <%=result.price%>
                                </span>
                            </div>
                            <div class="overview-item2 overview-item3">
                                <span class="info-label">Ticker:</span>
                                <span class="info-value truncate-text">
                                    <%=icoData.ticker%>
                                </span>
                            </div>

                            <div class="overview-item2 overview-item3">
                                <span class="info-label truncate-text">Block Chain:</span>
                                <span class="info-value truncate-text" title="<%=icoData.initialCirculationSupply%>">
                                    <div class="blockchain-tags">
                                        <% const maxVisible2=3; const blockChain=icoData.blockChain || []; const
                                            blockChainTag=blockChain.slice(0, maxVisible2); const
                                            remainingCount2=blockChain.length - blockChainTag.length; %>

                                            <% blockChainTag.forEach(tag=> { %>
                                                <span class="badge gray">
                                                    <%= tag %>
                                                </span>
                                                <% }) %>

                                                    <% if (remainingCount2> 0) { %>
                                                        <span class="badge light">+<%= remainingCount2 %></span>
                                                        <% } %>
                                    </div>
                                </span>
                            </div>
                            <div class="overview-item2 overview-item3">
                                <span class="info-label truncate-text">Industry:</span>
                                <span class="info-value truncate-text" title="<%=icoData.initialCirculationSupply%>">
                                    <div class="blockchain-tags">
                                        <% const maxVisible=1; const industry=icoData.industry || []; const
                                            industryTag=industry.slice(0, maxVisible); const
                                            remainingCount=industry.length - industryTag.length; %>

                                            <% industryTag.forEach(tag=> { %>
                                                <span class="badge gray truncate-text">
                                                    <%= tag %>
                                                </span>
                                                <% }) %>

                                                    <% if (remainingCount> 0) { %>
                                                        <span class="badge light">+<%= remainingCount %></span>
                                                        <% } %>
                                    </div>
                                </span>
                            </div>
                            <div class="overview-item2 overview-item3">
                                <span class="info-label">Sale Qty:</span>
                                <span class="info-value truncate-text">
                                    <%=result.tokenForSale%>
                                </span>
                            </div>
                            <div class="overview-item2 overview-item3">
                                <span class="info-label">Raise:</span>
                                <span class="info-value truncate-text">
                                    <%=result.raisePrice%>
                                </span>
                            </div>






                        </div>
                        <% })%>
                </div>
                <div class="overview-section">
                    <h2>
                        Economy
                    </h2>
                    <div class="overviewMain">

                        <div class="overview-item overview-item3">
                            <span class="info-label">Total Raise:</span>
                            <span class="info-value truncate-text">
                                <%=icoData.totalRaise%>
                            </span>
                        </div>
                        <div class="overview-item overview-item3">
                            <span class="info-label">Pre Sale:</span>
                            <span class="info-value truncate-text">
                                <%=icoData.preSale%>
                            </span>
                        </div>
                        <div class="overview-item overview-item3">
                            <span class="info-label">FDV:</span>
                            <span class="info-value truncate-text">
                                <%=icoData.fdv%>
                            </span>
                        </div>
                        <div class="overview-item overview-item3">
                            <span class="info-label">Total Supply:</span>
                            <span class="info-value truncate-text">
                                <%=icoData.totalSupply%>
                            </span>
                        </div>
                        <div class="overview-item overview-item3">
                            <span class="info-label">Public Sale:</span>
                            <span class="info-value truncate-text" title="<%=icoData.publicSale%>">
                                <%=icoData.publicSale%>
                            </span>
                        </div>



                    </div>
                </div>
            </div>
        </div>


        <%- include("../../partials/frountFooter.ejs")%>

            <script>
                // Hamburger Menu Toggle (for opening and closing the nav)
                // Hamburger menu click (for opening the sidebar)
                document.getElementById('hamburger-menu').addEventListener('click', function () {
                    document.getElementById('sidebar').classList.add('active');
                });

                // Close button click (for closing the sidebar)
                document.getElementById('close-btn').addEventListener('click', function () {
                    document.getElementById('sidebar').classList.remove('active');
                });


            </script>
</body>

</html>