<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
   <link rel="icon" href="../../image/tRjsqSe3_400x400.jpg" type="image/x-icon">
   <meta name="robots" content="noindex, nofollow">


  <title>iNDEX</title>

  <style>
    * {
      box-sizing: border-box;
    }

   

    .breadcrumb {
      font-size: 14px;
      margin: 22px 0px;
      letter-spacing: 1px;
      color: #555;
    }

    .breadcrumb a {
      color: #1a73e8;
      text-decoration: none;
    }

    .form-container {
      max-width: 700px;
      margin: auto;
      background: white;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
    }

    .form-group {
      margin-bottom: 20px;
    }

    label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
    }

    input[type="text"],
    input[type="url"],
    input[type="date"],
    select,
    .location {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
    }

    .inline-group {
      display: flex;
      gap: 15px;
    }

    .inline-group .form-group {
      flex: 1;
    }

    .upload-box {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px;
      border: 2px dashed #ccc;
      border-radius: 6px;
    }

    .upload-box .text {
      font-size: 14px;
      color: #333;
    }

    .upload-box .upload-btn {
      color: #0056d2;
      font-weight: bold;
      cursor: pointer;
    }

    .flag-select {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .flag-select img {
      width: 24px;
      height: 18px;
      border: 1px solid #ccc;
    }

    .timezone-box {
      border: 1px solid #ccc;
      border-radius: 6px;
      padding: 10px;
      font-size: 14px;
    }

    .event-type {
      display: inline-block;
      padding: 10px 15px;
      background: #f0f6ff;
      border-radius: 6px;
      font-weight: 500;
      border: 1px solid #d0e3ff;
      color: #0056d2;
    }



    #countryDropdown {
      border: 0;
      padding: 0;
      width: 100%;
    }

    .startDate {
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      width: 100%;
    }

    .checkbox-container label {
      display: inline-block;
      margin-right: 15px;
      /* horizontal gap */
      margin-bottom: 8px;
      /* vertical gap */
      cursor: pointer;
    }

    .multiselect-container {
      position: relative;
      width: 250px;
    }

    .select-box {
      border: 1px solid #ccc;
      padding: 10px;
      border-radius: 6px;
      cursor: pointer;
    }

    .options-container {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      max-height: 200px;
      overflow-y: auto;
      border: 1px solid #ccc;
      border-top: none;
      background-color: white;
      z-index: 10;
      padding: 10px;
    }

    .options-container label {
      display: flex;
      align-items: center;
      margin-bottom: 8px;
      cursor: pointer;
    }

    .options-container label input {
      margin-right: 10px;
    }

    .multiselect-container.active .options-container {
      display: block;
    }

    .decsTextarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
    }

    .eventBtn {
      padding: 9px 31px;
      background: #f9d3d3;
      margin-left: auto;
      color: #000;
      text-decoration: none;
      border-radius: 18px;
      font-weight: 400;
      border: navajowhite;
      margin: 19px 0px;
    }

    .sponsers {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .innerSpronsers {
      width: 30%;
      margin: 10px 0px;
    }

    .addButton {
      background: #e1ffed;
      font-size: 13px;
      border: navajowhite;
      border: solid 1px #d9d9d9;
      padding: 7px 13px;
      font-weight: 500;
      margin-top: 8px;
    }

    .input-row {
      display: flex;
      gap: 10px;
      margin-bottom: 10px;
    }

    .input-row input {
      flex: 1;
      padding: 5px;
    }

    .paid-inputs {
      display: none;
      margin-top: 15px;
    }

    .authorInput {
      width: 100%;
      padding: 10px;
    }

    .authorDiv {
      margin: 15px 0px;
      width: 50% !important;
    }

    #loader {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(255, 255, 255, 0.8);
      z-index: 9999;
      justify-content: center;
      align-items: center;
      font-size: 2rem;
      color: #333;
      text-align: center;
    }

    #loader img {
      margin-top: 18%;
    }
     body {
            /* font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; */
            background: #fff;
            color: #111;
            font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif !important;
            overflow-x: hidden;
            margin: 0;

        }

        h1,
        h2,
        h3,
        p,
        span {
            font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif !important;

        }




        /* Main header styling */
        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 48px;
            border-bottom: 1px solid #eee;
            flex-wrap: wrap;
            /* Wrapping to allow proper stacking in mobile view */
        }

        .logo {
            display: flex;
            align-items: center;
            font-size: 32px;
            font-weight: bold;
            color: #111;
        }

        .hamburger-menu {
            display: none;
            cursor: pointer;
            font-size: 30px;
        }

        /* Normal desktop navigation */
        nav {
            display: flex;
            align-items: center;
            flex-grow: 1;
            white-space: nowrap;
            justify-content: center;
        }

        nav a {
            margin: 0 10px;
            text-decoration: none;
            color: #111;
            font-weight: 500;
        }

        nav a:hover {
            color: #0b74de;
        }

        .dropdown {
            position: relative;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 8px;
            padding: 10px 0;
            z-index: 10;
        }

        .dropdown-content a {
            display: block;
            padding: 10px 15px;
            color: #111;
        }

        .dropdown-content a:hover {
            background: #fafafa;
            color: #0b74de;
        }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        /* Sidebar Styling */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 90%;
            height: 100%;
            background: #fff;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
            transform: translateX(-100%);
            /* Sidebar hidden off-screen initially */
            transition: transform 0.5s ease;
            /* Smooth slide-in transition */
        }

        /* Active state (when sidebar is open) */
        .sidebar.active {
            transform: translateX(0);
            /* Slide-in to the left side */
        }

        .sidebar-logo {

            padding: 20px 12px;

        }

        .sidebar-logo img {
            width: 65% !important;
        }

        .close-btn {
            font-size: 30px;
            color: #111;
            position: absolute;
            top: 20px;
            right: 20px;
            cursor: pointer;
        }


        /* Media Query for Mobile (Less than or equal to 768px) */
        @media (max-width: 768px) {

            /* Display the hamburger menu for mobile */
            .hamburger-menu {
                display: block;
            }

            /* Hide the normal desktop navigation */
            nav {
                display: none;
            }

            /* Sidebar active on mobile */
            .sidebar.active {
                display: block;
            }

            .logo a img {
                width: 85% !important;
            }

            header {
                align-items: unset !important;
                flex-wrap: unset !important;
                padding: 15px 14px;
                flex-direction: unset;
                border: 1px solid #eee;
            }

            .hamburger-menu {
                font-size: 24px;
            }

            .logo {
                margin-bottom: 0;
            }

            .dropdown {
                background: #f6f6f6;
            }

        }

        .dropdown {
            position: relative;
            /* color: #000; */
            padding: 8px 10px;

            margin-bottom: 11px;
        }

        .dropdown a {
            text-decoration: none;
            color: #000;
        }
  </style>

</head>

<body>

  <!-- header start -->

  <%- include("../../partials/frountHeader.ejs")%>
    <!-- header end -->


    <section>
      <div class="container">
        <div class="breadcrumb">
          <a href="/" style="color: #555;">Home </a> ><a href="/influencers" style="color: #555;">Influencer </a> > <a
            href="#">Add Influencer</a>
        </div>
        <h2>Add Influencer</h2>
      </div>
    </section>
    <section>
      <div id="loader">
        <img src="../../image/Animation - 1749114626093.gif" alt="">
        <h4>Loading...</h4>

      </div>
    </section>

    <form action="/createInfluencer" method="post" enctype="multipart/form-data" onsubmit="showLoader()">

      <section>
        <div class="container">
          <div class="form-container">
            <div class="form-group">
              <label>Influencer Name <span style="color:red">*</span></label>
              <input name="name" type="text" placeholder="Enter Influencer Name " required />
            </div>

            <div class="form-group">
              <label> Profile Image  <span style="color:red">*</span></label>
              <div class="upload-box">
                <div class="text">
                  Drag and drop an image or <strong>1250 x 656</strong> (in pixels).<br />
                  PNG, JPEG, <strong>SVG</strong> are Supported
                </div>
                <input type="file" name="profileImage" required>
              </div>
            </div>

            <div class="inline-group">
              <div class="form-group">
                <label>Facebook Profile Link  <span style="color:red">*</span></label>
                <input name="facebook" class="form-control" type="text" />
              </div>
              <div class="form-group">
                <label>Twitter Profile Link  <span style="color:red">*</span></label>
                <input name="twitter" class="form-control" type="url" />
              </div>
            </div>
            <div class="inline-group">
              <div class="form-group">
                <label>Instagram Profile Link  <span style="color:red">*</span></label>
                <input name="instagram" class="form-control" type="text" />
              </div>
              <div class="form-group">
                <label>Reddit Profile Link  <span style="color:red">*</span></label>
                <input name="reddit" class="form-control" type="url" />
              </div>
            </div>
            <div class="inline-group">
              <div class="form-group">
                <label>Teligram Handle's Link  <span style="color:red">*</span></label>
                <input name="teligramHandle" class="form-control" type="text" />
              </div>
              <div class="form-group">
                <label>Telegram's Channel/Group Link  <span style="color:red">*</span></label>
                <input name="telegramChannel" class="form-control" type="url" />
              </div>
            </div>
             <div class="inline-group">
              <div class="form-group">
                <label>LinkedIn Profile Link  <span style="color:red">*</span></label>
                <input name="linkedIn" class="form-control" type="text" />
              </div>
              <div class="form-group">
                <label>Dicord Channel Link  <span style="color:red">*</span></label>
                <input name="discord" class="form-control" type="url" />
              </div>
            </div>
              <div class="inline-group">
              <div class="form-group">
                <label>Whatsapp  <span style="color:red">*</span></label>
                <input name="whatsapp" class="form-control" type="text" />
              </div>
              <div class="form-group">
                <label>Youtube Channel Link  <span style="color:red">*</span></label>
                <input name="youtube" class="form-control" type="url" />
              </div>
            </div>
            <div>
            </div>
  
            <button type="submit" class="eventBtn">Submit</button>

          </div>




      </section>
    </form>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>



    <script>
      $(document).ready(function () {
        $('#countryCodeSelect').select2({
          placeholder: "Search country or code...",
          allowClear: true
        });
      });
    </script>

    <script>
      function toggleDropdown() {
        document.getElementById("multiselect").classList.toggle("active");
      }

      // Optional: close if clicked outside
      document.addEventListener("click", function (e) {
        const multiselect = document.getElementById("multiselect");
        if (!multiselect.contains(e.target)) {
          multiselect.classList.remove("active");
        }
      });
    </script>

    <script type="text/javascript" src="../../ckeditor/ckeditor.js"></script>
    <script>
      CKEDITOR.replace("editor")
    </script>

    <script>
      const ticketTypeSelect = document.getElementById("ticketType");
      const paidInputs = document.getElementById("paidInputs");

      ticketTypeSelect.addEventListener("change", function () {
        if (this.value === "paid") {
          paidInputs.style.display = "block";
        } else {
          paidInputs.style.display = "none";
        }
      });
    </script>
    <script>
      function showLoader() {
        document.getElementById('loader').style.display = 'block';
      }
    </script>

     <script>
                // Hamburger Menu Toggle (for opening and closing the nav)
                // Hamburger menu click (for opening the sidebar)
                document.getElementById('hamburger-menu').addEventListener('click', function () {
                    document.getElementById('sidebar').classList.add('active');
                });

                // Close button click (for closing the sidebar)
                document.getElementById('close-btn').addEventListener('click', function () {
                    document.getElementById('sidebar').classList.remove('active');
                });


            </script>


</body>

</html>