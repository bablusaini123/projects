<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700&family=DM+Sans:wght@400;500&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

  <title>Influencer Listing</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f0f0f0;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 15px 20px;
      background-color: #333;
      color: white;
      flex-wrap: wrap;
    }

    .logo {
      font-size: 1.5rem;
      font-weight: bold;
    }

    .search-bar {
      flex: 1 1 300px;
      margin: 10px 20px;
    }

    .search-bar input {
      width: 100%;
      padding: 8px 10px;
      border-radius: 20px;
      border: none;
      font-size: 1rem;
    }

    nav {
      display: flex;
      gap: 15px;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: 500;
      padding: 6px 10px;
      transition: background 0.3s;
    }

    nav a:hover {
      background-color: #555;
      border-radius: 5px;
    }

    .menu-toggle {
      display: none;
      flex-direction: column;
      cursor: pointer;
    }

    .menu-toggle span {
      width: 25px;
      height: 3px;
      background: white;
      margin: 4px 0;
    }

    @media (max-width: 768px) {
      .search-bar {
        flex: 1 1 100%;
        order: 3;
        margin: 10px 0;
      }

      nav {
        display: none;
        flex-direction: column;
        width: 100%;
        margin-top: 10px;
        background-color: #444;
        order: 4;
      }

      nav a {
        padding: 10px;
        border-top: 1px solid #555;
      }

      nav.show {
        display: flex;
      }

      .menu-toggle {
        display: flex;
      }
    }

    .card-container {
      display: flex;
      flex-wrap: wrap;

      gap: 33px;
      justify-content: start;
    }

    .card {
      background-color: #fff;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      width: 100%;
      transition: transform 0.2s;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      max-width: 23%;
    }

    .card:hover {
      transform: translateY(-5px);
    }

    .card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .card-body {
      padding: 15px 8px;
    }

    .tags {
      display: flex;
      gap: 10px;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }

    .tag {
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 12px;
      background: #e0f7e9;
      color: #2e7d32;
    }

    .tag.crypto {
      background: #e3f2fd;
      color: #1565c0;
    }

    .card-title {
      font-size: 18px;
      font-weight: bold;
      margin: 5px 0 10px;
    }

    .card-info {
      font-size: 14px;
      color: #555;
      margin-bottom: 10px;
    }

    .card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
    }

    .link {
      text-decoration: none;
      color: #1e88e5;
      font-weight: 500;
    }

    @media (min-width: 768px) {
      .card {
        flex: 1 1 calc(50% - 20px);
      }
    }

    @media (min-width: 1024px) {
      .card {
        flex: 1 1 calc(25% - 20px);
      }
    }

    .listingSection {
      margin-top: 30px;
    }

    .breadcrumb {
      font-size: 14px;
      margin: 22px 0px;
      letter-spacing: 1px;
      color: #555;
    }

    .breadcrumb a {
      color: #1a73e8;
      text-decoration: none;
    }

    .tabs {
      display: flex;
      border-bottom: 1px solid #ddd;
      margin-bottom: 20px;
    }

    .tab {
      padding: 10px 20px;
      cursor: pointer;
      font-weight: 500;
      color: #333;
      border-bottom: 3px solid transparent;
      transition: border-bottom 0.3s;
    }

    .tab.active {
      border-bottom: 3px solid #1a73e8;
      color: #1a73e8;
      background: #eef4ff;
      border-top-left-radius: 5px;
      border-top-right-radius: 5px;
    }

    .filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      justify-content: space-between;
    }

    .filter-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    .filter-button,
    .dropdown,
    .reset-link {
      padding: 8px 12px;
      border: 1px solid #ddd;
      border-radius: 20px;
      background: #fff;
      font-size: 14px;
      cursor: pointer;
    }

    .filter-button:hover,
    .dropdown:hover,
    .reset-link:hover {
      background: #f0f0f0;
      color: black;
      transition: 0.7s;

    }

    .reset-link {
      color: #1a73e8;
      border: none;
      background: none;
      text-decoration: underline;
    }

    .create-search {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-top: 10px;
    }

    .create-btn {
      background-color: #0061ff;
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      cursor: pointer;
    }

    .search-box {
      display: flex;
      align-items: center;
      border: 1px solid #ddd;
      border-radius: 20px;
      padding: 8px 12px;
      background: white;
    }

    .search-box input {
      border: none;
      outline: none;
      font-size: 14px;
      padding-left: 8px;
    }

    .search-box svg {
      color: #888;
    }

    @media (max-width: 768px) {
      .filters {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }

      .create-search {
        flex-direction: column;
        align-items: flex-start;
        width: 100%;
      }

      .search-box {
        width: 100%;
      }
    }

    .eventBtn {
      padding: 10px 29px;
      background: #655de6;
      margin-left: auto;
      color: #fff;
      text-decoration: none;
      border-radius: 18px;
      font-weight: 600;
    }

    .eventBtn:hover {
      color: #fff;
    }

    .profile-container {
      max-width: 1200px;
      margin: 0 auto;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .profile-card {
      width: 19%;
      align-items: center;
      padding: 7px 7px;
      gap: 30px;
      transition: all 0.3s ease;
      text-align: center;
      box-sizing: border-box;
      background: #fff;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      border-radius: 31px;
    }

    .profile-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
    }

    .profile-image {
    
      border-radius: 30px;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 48px;
      font-weight: bold;
      flex-shrink: 0;
      overflow: hidden;
      margin: auto;

    }

    .profile-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .profile-name {
      font-size: 1.5rem;
      font-weight: 700;
      color: #2d3748;
      margin-bottom: 5px;
    }

    .profile-whatsapp {
      color: #666;
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      gap: 8px;
      justify-content: center;
    }

    .social-links {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      align-items: center;
      justify-content: center;
    }

    .social-link {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: linear-gradient(45deg, #667eea, #764ba2);
      color: white;
      text-decoration: none;
      border-radius: 25px;
      font-size: 0.9rem;
      font-weight: 500;
      transition: all 0.3s ease;
    }

    .social-link:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
      background: linear-gradient(45deg, #764ba2, #667eea);
      color: #fff;
    }

    .social-link.facebook {
      background: linear-gradient(45deg, #1877f2, #42a5f5);
    }

    .social-link.twitter {
      background: linear-gradient(45deg, #1da1f2, #42a5f5);
    }

    .social-link.instagram {
      background: linear-gradient(45deg, #f9ce34, #ee2a7b, #6228d7);
    }

    .social-link.reddit {
      background: linear-gradient(45deg, #ff4500, #ff6b35);
    }

    .social-link.telegram {
      background: linear-gradient(45deg, #0088cc, #229ed9);
    }

    .social-link.linkedin {
      background: linear-gradient(45deg, #0077b5, #00a0dc);
    }

    .social-link.discord {
      background: linear-gradient(45deg, #5865f2, #7289da);
    }

    .social-link.youtube {
      background: linear-gradient(45deg, #ff0000, #ff4444);
    }

    .icon {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }

    @media (max-width: 768px) {
      .profile-card {
        flex-direction: column;
        text-align: center;
        padding: 20px;
      }

      .profile-name {
        font-size: 1.5rem;
      }

      .social-links {
        justify-content: center;
      }

      .social-link {
        font-size: 0.8rem;
        padding: 6px 12px;
      }
    }

    .mainInfluencer {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: space-between;
    }
  </style>
</head>

<body>

  <!-- header start -->

