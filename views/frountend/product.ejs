<meta name="description" content="Buy Bitcoin & crypto miners online. Compare ASIC & GPU mining rigs by price, profit, algorithm & electricity cost. Find the best miner for 2025 ROI.">
    <link rel="canonical" href="https://czminers.com/miner" />
    
    <script>
  const encodedProductData = '<%- Buffer.from(JSON.stringify(productData || [])).toString("base64") %>';
  const decodedProducts = JSON.parse(atob(encodedProductData));

  const structuredProducts = decodedProducts.map((product, index) => ({
    "@type": "Product",
    "name": product.title,
    "url": `https://czminers.com/miner/${product.slug}`,
    "image": product.productImages[0] || [],
    "description": product.overview
      ? product.overview.replace(/(<([^>]+)>)/gi, '').replace(/\n/g, ' ').replace(/"/g, '\\"')
      : '',
    "sku": product.slug,
    "mpn": product._id,
    "brand": {
      "@type": "Brand",
      "name": product.brand
    },
    "additionalProperty": [
      {
        "@type": "PropertyValue",
        "name": "Algorithm",
        "value": product.algorithm
      },
      {
        "@type": "PropertyValue",
        "name": "Coins Supported",
        "value": (product.coin || []).join(', ')
      },
      {
        "@type": "PropertyValue",
        "name": "Power",
        "value": product.power
      },
      {
        "@type": "PropertyValue",
        "name": "Hash Rate",
        "value": product.hashRate
      },
      {
        "@type": "PropertyValue",
        "name": "Product Type",
        "value": product.productType
      }
    ],
    "offers": {
      "@type": "Offer",
      "url": `https://czminers.com/miner/${product.slug}`,
      "priceCurrency": "USD",
      "price": (product.sellPrice || '0').replace('US$', '').replace(',', ''),
      "priceValidUntil": "2025-12-31",
      "itemCondition": "https://schema.org/NewCondition",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@type": "Organization",
        "name": "Blockchain Miners"
      },
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": {
          "@type": "MonetaryAmount",
          "value": "0",
          "currency": "USD"
        },
        "shippingDestination": {
          "@type": "DefinedRegion",
          "addressCountry": "US"
        },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": {
            "@type": "QuantitativeValue",
            "value": 2,
            "unitCode": "d"
          },
          "transitTime": {
            "@type": "QuantitativeValue",
            "value": 5,
            "unitCode": "d"
          }
        }
      }
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.5",
      "reviewCount": "25"
    },
    "review": [
      {
        "@type": "Review",
        "author": {
          "@type": "Person",
          "name": "John Doe"
        },
        "datePublished": "2024-04-01",
        "reviewBody": "Excellent miner with great performance.",
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": "5",
          "bestRating": "5"
        }
      }
    ],
    "warranty": {
      "@type": "WarrantyPromise",
      "durationOfWarranty": "P1Y",
      "warrantyScope": "https://schema.org/LimitedWarranty"
    }
  }));

  const jsonLd = {
    "@context": "https://schema.org",
    "@graph": structuredProducts
  };

  const scriptTag = document.createElement("script");
  scriptTag.type = "application/ld+json";
  scriptTag.text = JSON.stringify(jsonLd);
  document.head.appendChild(scriptTag);
</script>



