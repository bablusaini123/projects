                                                                </ul>
                                                            </div>

                                                            <span class="price"><span
                                                                    class="woocommerce-Price-amount amount"><bdi></span>
                                                                <span class="woocommerce-Price-amount amount"><bdi><span
                                                                            class="woocommerce-Price-currencySymbol">
                                                                            <%=result.sellPrice%></bdi></span></span>
                                                        </a><a href=""
                                                            aria-describedby="woocommerce_loop_add_to_cart_link_describedby_24783"
                                                            data-quantity="1"
                                                            class="button product_type_variable add_to_cart_button"
                                                            data-product_id="24783" data-product_sku="WM61S"
                                                            aria-label="Elige las opciones para “MicroBT Whatsminer M61S Bitcoin Miner”"
                                                            rel="nofollow">Seleccionar opciones</a> <span
                                                            id="woocommerce_loop_add_to_cart_link_describedby_24783"
                                                            class="screen-reader-text">
                                                            This product has multiple variants. The options may be
                                                            chosen on
                                                            the
                                                            product page </span>
                                                        <div class="fav_cart">
                                                            <a href=""
                                                                class="button add_to_cart_button ajax_add_to_cart"><img
                                                                    alt="cart" src="../../image/shopping-cart.svg"
                                                                    width="24" height="25"></a>
                                                        </div>
                                                    </li>
                                                    <% }) %>
                                            </ul>
                                            <section style="margin-left: auto;">
                                                <div class="pagination-container">
                                                    <% if (current> 1) { %>
                                                        <a href="/miner?page=<%= current - 1 %>&brand=<%= brand %>&algorithm=<%= algorithm %>"
                                                            class="page-box">‹</a>
                                                        <% } else { %>
                                                            <span class="page-box disabled">‹</span>
                                                            <% } %>

                                                                <% if (current> 2) { %>
                                                                    <a href="/miner?page=1&brand=<%= brand %>&algorithm=<%= algorithm %>"
                                                                        class="page-box">1</a>
                                                                    <% } %>

                                                                        <% if (current> 3) { %>
                                                                            <span class="page-box dots">...</span>
                                                                            <% } %>

                                                                                <% for (let i=1; i <=pages; i++) { %>
                                                                                    <!-- Corrected loop -->
                                                                                    <a href="/miner?page=<%= i %>&brand=<%= brand %>&algorithm=<%= algorithm %>"
                                                                                        class="page-box <%= current === i ? 'active' : '' %>">
                                                                                        <%= i %>
                                                                                    </a>
                                                                                    <% } %>

                                                                                        <% if (current < pages - 2) { %>
                                                                                            <span
                                                                                                class="page-box dots">...</span>
                                                                                            <% } %>

                                                                                                <% if (current < pages)
                                                                                                    { %>
                                                                                                    <a href="/miner?page=<%= current + 1 %>&brand=<%= brand %>&algorithm=<%= algorithm %>"
                                                                                                        class="page-box">›</a>
                                                                                                    <% } else { %>
                                                                                                        <span
                                                                                                            class="page-box disabled">›</span>
                                                                                                        <% } %>
                                                </div>
                                            </section>


                                        </div>
                                    </div>
                                </div>



                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>




