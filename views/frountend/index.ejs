                gap: 0 !important;
            }
            .footer-bottom{
                padding-top: 0px;
            }
            .newsletter-section{
                margin-bottom: 17px;
                padding-bottom: 20px;
            }

        }

        .dropdown {
            position: relative;
            /* color: #000; */
            padding: 8px 10px;

            margin-bottom: 11px;
        }

        .dropdown a {
            text-decoration: none;
            color: #000;
        }

        .newsBox {
