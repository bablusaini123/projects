	<link rel="canonical" href="https://czminers.com" />

	<script>
		// Base64 se product data decode karo (server side se aise milta hai)
		const encodedProductData = '<%- Buffer.from(JSON.stringify(productData || [])).toString("base64") %>';
		const decodedProducts = JSON.parse(atob(encodedProductData));

		const structuredData = [];

		// Organization
		structuredData.push({
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "Blockchain Miners",
			"url": "https://czminers.com",
			"logo": "https://czminers.com/logo.png", // Make sure yeh valid URL ho
			"contactPoint": {
				"@type": "ContactPoint",
				"telephone": "+1-000-000-0000",
				"contactType": "Customer Support",
				"email": "support@czminers.com"
			},
			"sameAs": [
				"https://twitter.com/blockchainminers",
				"https://facebook.com/blockchainminers"
			]
		});

		// WebSite with SearchAction
		structuredData.push({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "Blockchain Miners",
			"url": "https://czminers.com",
			"potentialAction": {
				"@type": "SearchAction",
				"target": "https://czminers.com/miner?brand={search_term_string}",
				"query-input": "required name=search_term_string"
			}
		});

		// WebPage
		structuredData.push({
			"@context": "https://schema.org",
			"@type": "WebPage",
			"name": "Blockchain Miners - Crypto Mining Hardware",
			"url": "https://czminers.com",
			"description": "Buy top crypto miners including Bitcoin, Dogecoin, and other altcoin mining rigs at czminers.com.",
			"inLanguage": "en-US"
		});

		// BreadcrumbList
		structuredData.push({
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Home",
					"item": "https://czminers.com"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Miners",
					"item": "https://czminers.com/miner"
				}
			]
		});

		// ItemList with Products (including image and offers)
		structuredData.push({
			"@context": "https://schema.org",
			"@type": "ItemList",
			"name": "Crypto Miners",
			"url": "https://czminers.com/miner",
			"itemListElement": decodedProducts.map((product, index) => ({
				"@type": "ListItem",
				"position": index + 1,
				"item": {
					"@type": "Product",
					"name": product.title || "Unknown Product",
					"url": `https://czminers.com/miner/${product.slug}`,
					"image": Array.isArray(product.productImages) && product.productImages.length > 0
						? product.productImages[0]
						: "https://czminers.com/default-product-image.png",  // Fallback image URL (change as needed)
					"description": product.overview
						? product.overview.replace(/(<([^>]+)>)/gi, '').replace(/\n/g, ' ').trim()
						: "No description available.",
					"sku": product.slug || "",
					"mpn": product._id || "",
					"brand": {
						"@type": "Brand",
						"name": product.brand || "Blockchain Miners"
					},
					"offers": {
						"@type": "Offer",
						"url": `https://czminers.com/miner/${product.slug}`,
						"priceCurrency": "USD",
						"price": product.sellPrice ? product.sellPrice.replace(/[^0-9.]/g, '') : "0",
						"availability": "https://schema.org/InStock",
						"itemCondition": "https://schema.org/NewCondition"
					},
					"aggregateRating": {
						"@type": "AggregateRating",
						"ratingValue": product.ratingValue || "4.5",
						"reviewCount": product.reviewCount || "25"
					}
				}
			}))
		});

		// Render the combined JSON-LD into <head>
		const jsonLdScript = document.createElement("script");
		jsonLdScript.type = "application/ld+json";
		jsonLdScript.text = JSON.stringify(structuredData, null, 2);
		document.head.appendChild(jsonLdScript);
	</script>





