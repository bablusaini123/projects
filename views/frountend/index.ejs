            color: #9c6b00;
        }

        .card {
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            width: 100%;
            transition: transform 0.2s;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            max-width: 14%;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .card-body {
            padding: 7px 7px 0px 7px;
        }

        .tags {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        .tag {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            background: #e0f7e9;
            color: #2e7d32;
        }

        .tag.crypto {
            background: #e3f2fd;
            color: #1565c0;
        }

        .card-title {
            font-size: 18px;
            font-weight: bold;
            margin: 5px 0 10px;
        }

        .card-info {
            font-size: 14px;
            color: #555;
            margin-bottom: 10px;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 14px;
        }

        .slider-container {
            background: #e0e0e0;
            width: 100%;
            overflow: hidden;
            position: relative;
            background: rgba(255, 255, 255, 0.1);
            padding: 10px 0;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
        }

        .slider-wrapper {
            display: flex;
            animation: infiniteSlide 20s linear infinite;
        }

        .slide {
            min-width: 29px;
            height: 28px;
            margin: 0 10px;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s ease;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
        }

        .slide:hover {
            transform: translateY(-5px) scale(1.05);
        }

        .slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 15px;
        }

        .slide-content {
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.7);
            color: #fff;
            padding: 2px 5px;
            border-radius: 3px;
            font-size: 10px;
            white-space: nowrap;
            display: none;
        }

        .slide:hover .slide-content {
            display: block;
        }

        @keyframes infiniteSlide {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-50%);
            }
        }

        .slider-container::before,
        .slider-container::after {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            width: 100px;
            z-index: 2;
            pointer-events: none;
        }

        .slider-container::before {
            left: 0;
            background: linear-gradient(to right, rgba(255, 255, 255, 0.1), transparent);
        }

        .slider-container::after {
            right: 0;
            background: linear-gradient(to left, rgba(255, 255, 255, 0.1), transparent);
        }

        /* Main header styling */
        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 48px;
            border-bottom: 1px solid #eee;
            flex-wrap: wrap;
            /* Wrapping to allow proper stacking in mobile view */
        }

        .logo {
            display: flex;
            align-items: center;
            font-size: 32px;
            font-weight: bold;
            color: #111;
        }

        .hamburger-menu {
            display: none;
            cursor: pointer;
            font-size: 30px;
        }

        /* Normal desktop navigation */
        nav {
            display: flex;
            align-items: center;
            flex-grow: 1;
            white-space: nowrap;
            justify-content: center;
        }

        nav a {
            margin: 0 10px;
            text-decoration: none;
            color: #111;
            font-weight: 500;
        }

        nav a:hover {
            color: #0b74de;
        }

        .dropdown {
            position: relative;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 8px;
            padding: 10px 0;
            z-index: 10;
        }

        .dropdown-content a {
            display: block;
            padding: 10px 15px;
            color: #111;
        }

        .dropdown-content a:hover {
            background: #fafafa;
            color: #0b74de;
        }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        /* Sidebar Styling */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 90%;
            height: 100%;
            background: #fff;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
            transform: translateX(-100%);
            /* Sidebar hidden off-screen initially */
            transition: transform 0.5s ease;
            /* Smooth slide-in transition */
        }

        /* Active state (when sidebar is open) */
        .sidebar.active {
            transform: translateX(0);
            /* Slide-in to the left side */
        }

        .sidebar-logo {

            padding: 20px 12px;

        }

        .sidebar-logo img {
            width: 65% !important;
        }

        .close-btn {
            font-size: 30px;
            color: #111;
            position: absolute;
            top: 20px;
            right: 20px;
            cursor: pointer;
        }


        /* Media Query for Mobile (Less than or equal to 768px) */
        @media (max-width: 768px) {

            /* Display the hamburger menu for mobile */
            .hamburger-menu {
                display: block;
            }

            /* Hide the normal desktop navigation */
            nav {
                display: none;
            }

            /* Sidebar active on mobile */
            .sidebar.active {
                display: block;
            }

            .logo a img {
                width: 85% !important;
            }

            header {
                align-items: unset !important;
                flex-wrap: unset !important;
                padding: 15px 14px;
                flex-direction: unset;
                border: 1px solid #eee;
            }

            .hamburger-menu {
                font-size: 24px;
            }

            .logo {
                margin-bottom: 0;
            }

            .dropdown {
                background: #f6f6f6;
            }

            .icoBox {
                width: 100% !important;
                height: 66vh !important;
            }

            .newsBox {
                width: 100% !important;
            }

            .airdropBox {
                width: 100% !important;
                height: 66vh !important;
                overflow-y: unset !important;
                overflow: hidden;
            }

            .main-container {
                height: unset !important;
                padding: 0px 4px !important;
            }

            .airdropHeading {
                padding: 20px 12px !important;
            }


            .outerAirdrop {
                overflow-y: auto !important;
                border: 1px solid #e5e5e5;
            }

            .icons span i {
                font-size: 16px !important;
            }

            .extra-section {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin: 10px 5px !important;
                padding: 8px 0;
                border-top: 1px solid #eee;
