            color: #333;
        }

        .badge.light {
            background-color: #ffe9ba;
            color: #9c6b00;
        }

        .card {
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            width: 100%;
            transition: transform 0.2s;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            max-width: 14%;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .card-body {
            padding: 7px 7px 0px 7px;
        }

        .tags {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        .tag {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            background: #e0f7e9;
            color: #2e7d32;
        }

        .tag.crypto {
            background: #e3f2fd;
            color: #1565c0;
        }

        .card-title {
            font-size: 18px;
            font-weight: bold;
            margin: 5px 0 10px;
        }

        .card-info {
            font-size: 14px;
            color: #555;
            margin-bottom: 10px;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 14px;
        }

        .slider-container {
            background: #e0e0e0;
            width: 100%;
            overflow: hidden;
            position: relative;
            background: rgba(255, 255, 255, 0.1);
            padding: 10px 0;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
        }

        .slider-wrapper {
            display: flex;
            animation: infiniteSlide 20s linear infinite;
        }

        .slide {
            min-width: 29px;
            height: 28px;
            margin: 0 10px;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s ease;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
        }

        .slide:hover {
            transform: translateY(-5px) scale(1.05);
        }

        .slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 15px;
        }

        .slide-content {
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.7);
            color: #fff;
            padding: 2px 5px;
            border-radius: 3px;
            font-size: 10px;
            white-space: nowrap;
            display: none;
        }

        .slide:hover .slide-content {
            display: block;
        }

        @keyframes infiniteSlide {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-50%);
            }
        }

        .slider-container::before,
        .slider-container::after {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            width: 100px;
            z-index: 2;
            pointer-events: none;
        }

        .slider-container::before {
            left: 0;
            background: linear-gradient(to right, rgba(255, 255, 255, 0.1), transparent);
        }

        .slider-container::after {
            right: 0;
            background: linear-gradient(to left, rgba(255, 255, 255, 0.1), transparent);
        }
    </style>
</head>

