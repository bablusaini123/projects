    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #fff;
            color: #111;
        }

        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 40px;
            border-bottom: 1px solid #eee;
        }

        .logo {
            display: flex;
            align-items: center;
            font-size: 32px;
            font-weight: bold;
            color: #111;
        }

        .logo span {
            background: red;
            color: #fff;
            border-radius: 50%;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            font-size: 20px;
        }

        nav {
            display: flex;
            align-items: center;
        }

        nav a {
            margin: 0 10px;
            text-decoration: none;
            color: #111;
            font-weight: 500;
            position: relative; /* Needed for dropdown positioning */
        }

        nav a:hover {
            color: #e30613; /* Hover color to match theme */
        }

        .dropdown {
            position: relative;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            min-width: 200px;
            z-index: 10;
            padding: 10px 0;
        }

        .dropdown-content a {
            display: block;
            padding: 10px 15px;
            color: #111;
            font-weight: 400;
            font-size: 14px;
            text-decoration: none;
        }

        .dropdown-content a:hover {
            background: #fafafa;
            color: #e30613;
        }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        .download-btn {
            background: #e30613;
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
        }

        .main-container {
            display: grid;
            grid-template-columns: 3fr 5fr 3fr;
            gap: 40px;
            padding: 30px 70px;
            align-items: start;
        }

        .article {
            border: 1px solid #eee;
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
            display: flex;
            flex-direction: column;
            height: 100%;
            background-color: #fafafa;
        }

        .article img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .article .content {
            padding: 16px;
            flex: 1;
        }

        .article .category {
            color: red;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .article h3 {
            font-size: 18px;
            margin-bottom: 6px;
        }

        .article .meta {
            font-size: 13px;
            color: gray;
        }

        .top-stories h4 {
            color: red;
            font-weight: bold;
            font-size: 25px;
        }

        .story-item {
            display: flex;
            margin-bottom: 18px;
            align-items: center;
        }

        .story-item img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 15px;
            margin-right: 10px;
        }

        .story-item .text {
            font-size: 14px;
            line-height: 1.3;
            flex: 1;
        }

        .story-item .text span {
            display: block;
            font-weight: bold;
            color: #555;
        }

        .story-number {
            font-size: 36px;
            color: rgba(200, 200, 200, 0.3);
            font-weight: bold;
            margin-left: 10px;
        }

        .extra-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 10px 50px;
            padding: 8px 0;
            border-top: 1px solid #eee;
            border-bottom: 1px solid #eee;
            gap: 20px;
            flex-wrap: wrap;
        }

        .extra-card {
            display: flex;
            align-items: center;
            gap: 14px;
            flex: 1;
            min-width: 200px;
        }

        .icon {
            font-size: 20px;
            color: #e30613;
            background: #ffe5e5;
            padding: 4px;
            border-radius: 12px;
        }

        .extra-title {
            font-weight: bold;
            color: #000;
            font-size: 16px;
            margin-bottom: 4px;
        }

        .extra-sub {
            color: #555;
            font-size: 14px;
        }

        .divider {
            height: 40px;
            width: 1px;
            background: #eee;
        }

        /* Crash Course Box */
        .crash-course {
            margin: 40px auto;
            max-width: 900px;
            max-height: 800px;
            background: url('https://99bitcoins.com/wp-content/themes/99bitcoins/assets/dist/img/footer-ninety-nine.png') no-repeat 100% 100% / 418px 296px, radial-gradient(at 130% 100%, #fbc6ce, transparent 65%), radial-gradient(at -15% -10%, #fbc6ce, transparent 35%);
            border: 1px solid #ffd6dc;
            border-radius: 20px;
