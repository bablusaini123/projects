        }

        .crash-left li {
            margin-bottom: 10px;
            color: #333;
        }

        .crash-left .highlight {
            font-weight: bold;
            color: #e30613;
        }

        .crash-right {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .crash-right input {
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 16px;
        }

        .crash-right button {
            background: #e30613;
            color: #fff;
            font-size: 16px;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
        }

        .stars {
            margin-top: 10px;
        }

        .bitcoin-section {
            padding: 2rem;
            background-color: #f2f7fa;
        }

        .bitcoin-section h1 {
            font-size: 2rem;
            font-weight: 700;
            color: #1e1e1e;
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .bitcoin-guides {
            display: flex;
            justify-content: space-between;
            gap: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .bitcoin-art {
            flex: 1;
            width: 350px;
            height: 350px;
            background: #ffffff;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .bitcoin-art:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
        }

        .bitcoin-art img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            display: block;
        }

        .content {
            padding: 1rem;
            display: flex;
            flex-direction: column;
            height: 200px;
        }

        .category {
            font-size: 0.8rem;
            color: #0b74de;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        .content h3 {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1e1e1e;
            margin-bottom: 0.5rem;
            line-height: 1.4;
            overflow: hidden;
            text-overflow: ellipsis;
