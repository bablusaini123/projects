   <!-- Meta Title & Description for ICO Detail Page -->
<title><%= airdropData.tokenName %> ($<%= airdropData.tokenSymbol.replace('$', '') %>) Airdrop | New & Ongoing Crypto Airdrop 2025 | Claim Free Tokens - KryptoDesk</title>
<meta name="description" content="Looking for new crypto airdrops? Claim free <%= airdropData.tokenSymbol %> tokens from the <%= airdropData.tokenName %> airdrop 2025. Built on Ethereum & IPFS. Explore tokenomics, roadmap, and how to participate — only on KryptoDesk.">
 <link rel="icon" href="../../image/tRjsqSe3_400x400.jpg" type="image/x-icon">
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

        <!-- Open Graph Meta Tags for WhatsApp & Social Sharing -->
    <meta property="og:title" content="<%= airdropData.tokenName %>" />
    <meta property="og:description"
        content="Looking for new crypto airdrops? Claim free <%= airdropData.tokenSymbol %> tokens from the <%= airdropData.tokenName %> airdrop 2025. Built on Ethereum & IPFS. Explore tokenomics, roadmap, and how to participate — only on KryptoDesk." />
    <meta property="og:url" content="https://kryptodesk.com/airdrops/<%= airdropData.slug %>" />
    <meta property="og:image" content="<%= airdropData.bannerImage || 'https://kryptodesk.com/image/kryptodesk-logo.png' %>" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KryptoDesk" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= airdropData.tokenName %>" />
    <meta name="twitter:description" content="Looking for new crypto airdrops? Claim free <%= airdropData.tokenSymbol %> tokens from the <%= airdropData.tokenName %> airdrop 2025. Built on Ethereum & IPFS. Explore tokenomics, roadmap, and how to participate — only on KryptoDesk!." />
    <meta name="twitter:image" content="<%= airdropData.bannerImage || 'https://kryptodesk.com/image/kryptodesk-logo.png' %>" />


   <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "<%= airdropData.tokenName %> ICO",
  "description": "<%= airdropData.projectDescription?.replace(/(<([^>]+)>)/gi, '').substring(0, 300) || 'Explore detailed information about this crypto AirDrop including tokenomics, roadmap, and team.' %>",
  "image": "<%= airdropData.tokenImage || 'https://kryptodesk.com/image/kryptodesk-logo.png' %>",
  "brand": {
    "@type": "Organization",
    "name": "<%= airdropData.tokenName %>"
  },
  "releaseDate": "<%= airdropData.startDate %>",
  "url": "https://kryptodesk.com/Airdrops/<%= airdropData.slug %>",
  "offers": {
  "@type": "Offer",
  "priceCurrency": "USD",
  "price": 1,
  "availability": "https://schema.org/PreOrder",
  "url": "https://kryptodesk.com/Airdrops/<%= airdropData.slug %>",
  "priceValidUntil": "<%= airdropData.endDate || new Date(new Date().getTime() + 14 * 24 * 60 * 60 * 1000).toISOString().split('T')[0] %>"
},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": "24"
  }
}
</script>

