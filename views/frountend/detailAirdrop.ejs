    }

    .checkbox {
      width: 16px;
      height: 16px;
    }

    .checkbox-label {
      font-size: 14px;
      color: #64748b;
    }

    .privacy-text {
      font-size: 12px;
      color: #94a3b8;
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.4;
    }

    .privacy-link {
      color: #0b74de;
      text-decoration: none;
    }

    .privacy-link:hover {
      text-decoration: underline;
    }

    .footer-content {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 40px;
    }

    .footer-brand {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .logo-icon {
      width: 32px;
      height: 32px;
      background: #0b74de;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
      font-size: 14px;
    }

    .logo-text {
      font-size: 20px;
      font-weight: 700;
      color: #1e293b;
    }

    .social-links {
      display: flex;
      gap: 12px;
    }

    .social-link {
      width: 36px;
      height: 36px;
      background: #f1f5f9;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #64748b;
      text-decoration: none;
      transition: all 0.2s;
    }

    .social-link:hover {
      background: #0b74de;
      color: white;
    }

    .footer-column {
      display: flex;
      flex-direction: column;
    }

    .footer-title {
      font-size: 16px;
      font-weight: 600;
      color: #1e293b;
      margin-bottom: 20px;
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .footer-link {
      color: #64748b;
      text-decoration: none;
      font-size: 14px;
      transition: color 0.2s;
    }

    .footer-link:hover {
      color: #0b74de;
    }

    .footer-bottom {
      padding-top: 30px;
      border-top: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .copyright {
      font-size: 14px;
      color: #0b74de;
    }

    .scroll-top {
      width: 40px;
      height: 40px;
      background: #0b74de;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      text-decoration: none;
      transition: background 0.2s;
    }

    .scroll-top:hover {
      background: #0b74de;
    }

   @media (max-width: 768px) {
      .footer-container {
        padding: 0 20px;
      }

      .newsletter-form {
        flex-direction: column;
        gap: 12px;
      }

      .email-input {
        border-radius: 8px;
        border-right: 1px solid #d1d5db;
      }

      .subscribe-btn {
        border-radius: 8px;
      }

      .footer-content {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .footer-bottom {
        flex-direction: column;
        gap: 20px;
        text-align: center;
      }
       /* Display the hamburger menu for mobile */
      .hamburger-menu {
        display: block;
      }

      /* Hide the normal desktop navigation */
      nav {
        display: none;
      }

      /* Sidebar active on mobile */
      .sidebar.active {
        display: block;
      }

      .logo a img {
        width: 85% !important;
      }

      header {
        align-items: unset !important;
        flex-wrap: unset !important;
        padding: 15px 14px;
        flex-direction: unset;
        border: 1px solid #eee;
      }

      .hamburger-menu {
        font-size: 24px;
      }

      .logo {
        margin-bottom: 0;
      }

      .dropdown {
        background: #f6f6f6;
      }

      .tab {
        padding: 6px 16px;
        font-weight: 600;
        font-size: 13px;
      }

      .eventBtn {
        padding: 0px 15px;
        background: #55b1ed;
        margin-left: auto;
        color: #000;
        text-decoration: none;
        border-radius: 18px;
        font-weight: 500;
        font-size: 11px;
        align-items: center;
        display: flex;
      }

      .card-container {
        flex-wrap: wrap;
      }

      .card {
        max-width: 100%;
      }

      .bitcoin-guides {
        margin: 0px 10px !important;
        gap: 0 !important;
      }

      .footer-bottom {
        padding-top: 0px;
      }

      .newsletter-section {
        margin-bottom: 17px !important;
        padding-bottom: 20px !important;
      }
      .newsletter-title{
        margin-top: 30px;
      }
       .filters {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }

      .create-search {
        flex-direction: column;
        align-items: flex-start;
        width: 100%;
      }

      .search-box {
        width: 100%;
      }
    }

    .newsletter-title{
        margin-top: 30px;
      }
    </style>
</head>

<body>
    <!-- header start -->

    <%- include("../../partials/frountHeader.ejs")%>
        <!-- header end -->

        <div class="container">
            <main class="main-content">
                <div class="breadcrumb">
                    <a href="/">Home</a> / <a href="/airdrop">Airdrop Listing</a> / <%=airdropData.tokenName%> • Waitlist
                </div>

                <div class="project-header">
                    <div class="project-logo">
                        <img src="<%=airdropData.tokenImage%>" alt="<%=airdropData.tokenImageAlt%>">
                    </div>
                    <div class="project-title">
                        <h1>
                            <%=airdropData.tokenName%> <%=airdropData.tokenSymbol%> 
                        </h1>
                    </div>
                    <a href="#" class="join-btn">Join</a>
                </div>

                <div class="project-meta">
                    <div class="meta-date">
                        <%=airdropData.formattedStartDate%> - <%=airdropData.formattendDate%>
                    </div>
                    <span class="status-badge easy">Easy</span>
                    <span class="status-badge high-reward">High Reward</span>
                    <span class="status-badge hot">Hot</span>
                    <span class="status-badge epic">Epic</span>
                    <span class="status-badge limited">Limited</span>
                </div>

                <div class="description">
                    <%-airdropData.projectDescription-%>
                </div>
                 <div class="description">
                   <img style="width: 100%;" src="<%=airdropData.bannerImage%>" alt="<%=airdropData.bannerImageAlt%>">
                </div>

                <div class="project-info">
                    <div class="info-row">
                        <span class="info-label">CoinLaunch Score:</span>
                        <span class="info-value">Very High</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Last update:</span>
                        <span class="info-value">07 Nov 2023</span>
                    </div>
                </div>

                <div class="overview-section">
                    <h2>
                        <%=airdropData.tokenName%> - Overview
                    </h2>
                    <div class="overviewMain">
                        <div class="overview-item">
                            <span class="info-label">Winning Date:</span>
                            <span class="info-value">
                                <%=airdropData.formattwinningDate%>
                            </span>
                        </div>

                        <div class="overview-item">
                            <span class="info-label">Cryptocurrency Type:</span>
                            <span class="info-value">
                                <%=airdropData.cryptocurrencyType%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Coin/ Token Quantity:</span>
                            <span class="info-value">
                                <%=airdropData.tokenQuantity%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Airdrop Quantity:</span>
                            <span class="info-value truncate-text">
                                <%=airdropData.airdropQuantity%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">No of Winners:</span>
                            <span class="info-value">
                                <%=airdropData.noOfWinners%>
                            </span>
                        </div>
                        <div class="overview-item">
                            <span class="info-label">Project Based On:</span>
                            <span class="info-value">
                                <%=airdropData.projectBasedOn%>
                            </span>
                        </div>
                       
                    </div>
                </div>
                <div class="overview-section">
                    <h2>
                        <%=airdropData.tokenName%> - Task Details
                    </h2>
                    <div>
                        <%-airdropData.taskDetails-%>
                    </div>


               

            </main>

            <aside class="sidebar">
                <div class="sidebar-card">
                    <div class="sidebar-header">
                        <span>Waitlist</span>
                        <span class="report-issue">Report Issue</span>
                    </div>

                    <div class="difficulty-section">
                        <h4>Difficulty</h4>
                        <div class="difficulty-badge">Easy</div>
                    </div>
                </div>

                <div class="sidebar-card countdown-card">
                    <div class="countdown-timer">-518 : 09 : 13 : 49</div>
                    <div class="countdown-label">days - hours - min - sec</div>

                    <div class="more-about">More about goodcryptoX</div>

                    <div class="social-buttons">
                        <a href="#" class="social-btn">🔗</a>
                        <a href="#" class="social-btn">🐦</a>
                        <a href="#" class="social-btn">💬</a>
                        <a href="#" class="social-btn">📱</a>
                    </div>
                </div>
            </aside>
        </div>

         <%- include("../../partials/frountFooter.ejs")%>

         <script>
                // Hamburger Menu Toggle (for opening and closing the nav)
                // Hamburger menu click (for opening the sidebar)
                document.getElementById('hamburger-menu').addEventListener('click', function () {
                    document.getElementById('sidebar').classList.add('active');
                });

                // Close button click (for closing the sidebar)
                document.getElementById('close-btn').addEventListener('click', function () {
                    document.getElementById('sidebar').classList.remove('active');
                });


            </script>
</body>

</html>