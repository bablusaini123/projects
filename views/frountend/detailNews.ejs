<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="icon" href="../../image/tRjsqSe3_400x400.jpg" type="image/x-icon">
    <meta name="robots" content="noindex, nofollow">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
      <title><%= newsData.title %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Unbounded', sans-serif;
            background-color: #ffffff;
            color: #000000;
            line-height: 1.5;
            overflow-x: hidden;
        }

        .banner {
            background: linear-gradient(135deg, #007bff, #0056b3);
            color: white;
            padding: 8px 0;
            text-align: center;
            font-size: 12px;
            font-weight: 500;
        }

        .lang-btn,
        .partnership-btn {
            padding: 8px 16px;
            border: 1px solid #ddd;
            background: white;
            border-radius: 6px;
            text-decoration: none;
            color: #333;
            font-size: 13px;
            font-weight: 500;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px 15px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .main-content {
            background: white;
            border: 1px solid #e5e5e5;
            border-radius: 12px;
            padding: 24px;
        }

        .breadcrumb {
            color: #666;
            font-size: 14px;
            margin-bottom: 20px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: flex-end;
        }

        .breadcrumb a {
            color: #666;
            text-decoration: none;
        }

        .project-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .project-logo {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #00c851, #007e33);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 20px;
            flex-shrink: 0;
            overflow: hidden;
        }

        .project-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .project-title {
            flex: 1;
        }

        .project-title h1 {
            font-size: 28px;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 0;
            color: #000;
        }

        .join-btn {
            background: #ff4757;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

        .project-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 20px;
            font-size: 12px;
        }

        .meta-date {
            color: #666;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .status-badge {
            padding: 4px 10px;
            border-radius: 16px;
            font-size: 11px;
            font-weight: 600;
            border: none;
        }

        .easy {
            background: #e8f5e8;
            color: #2d5a2d;
        }

        .high-reward {
            background: #fff8e1;
            color: #8b6914;
        }

        .high-reward::before {
            content: "🏆 ";
        }

        .hot {
            background: #ffeaa7;
            color: #d35400;
        }

        .epic {
            background: #f0f0f0;
            color: #2c3e50;
        }

        .limited {
            background: #e8f8f5;
            color: #00695c;
        }

        .description {
            margin-bottom: 20px;
            line-height: 1.6;
            color: #333;
            word-wrap: break-word;
        }

        .description img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
        }

        .description p,
        .description div,
        .description span,
        .description ul,
        .description ol,
        .description li {
            font-size: 14px;
            margin-bottom: 12px;
            max-width: 100%;
            overflow-wrap: break-word;
        }

        .description ul,
        .description ol {
            padding-left: 20px;
        }

        .project-info {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 15px;
            margin: 20px 0;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .info-label {
            color: #666;
            font-weight: 500;
            font-size: 13px;
        }

        .info-value {
            color: #333;
            font-weight: 600;
            font-size: 13px;
        }

        /* Original Header CSS */
        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 48px;
            border-bottom: 1px solid #eee;
            flex-wrap: wrap;
        }

        .logo {
            display: flex;
            align-items: center;
            font-size: 32px;
            font-weight: bold;
            color: #111;
            margin: 0px !important;
        }

        .logo span {
            background: #0b74de;
            color: #fff;
            border-radius: 50%;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            font-size: 20px;
        }

        nav {
            display: flex;
            align-items: center;
            white-space: nowrap;
        }

        nav a {
            margin: 0 10px;
            text-decoration: none;
            color: #111;
            font-weight: 500;
            position: relative;
        }

        nav a:hover {
            color: #0b74de;
        }

        .dropdown {
            position: relative;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            min-width: 200px;
            z-index: 10;
            padding: 10px 0;
        }

        .dropdown-content a {
            display: block;
            padding: 10px 15px;
            color: #111;
            font-weight: 400;
            font-size: 14px;
            text-decoration: none;
        }

        .dropdown-content a:hover {
            background: #fafafa;
            color: #0b74de;
        }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        .download-btn {
            background: #0b74de;
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
        }

        .hamburger-menu {
            display: none;
            cursor: pointer;
            font-size: 30px;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 90%;
            height: 100%;
            background: #fff;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
            transform: translateX(-100%);
            transition: transform 0.5s ease;
        }

        .sidebar.active {
            transform: translateX(0);
        }

        .sidebar-logo {
            padding: 20px 12px;
        }

        .sidebar-logo img {
            width: 65% !important;
        }

        .close-btn {
            font-size: 30px;
            color: #111;
            position: absolute;
            top: 20px;
            right: 20px;
            cursor: pointer;
        }

        /* Original Footer CSS */
        .footer {
            background: white;
            padding: 60px 0 40px;
            border-top: 1px solid #e2e8f0;
        }

        .footer-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 40px;
        }

        .newsletter-section {
            text-align: center;
            margin-bottom: 60px;
            padding-bottom: 40px;
            border-bottom: 1px solid #e2e8f0;
        }

        .newsletter-title {
            font-size: 28px;
            font-weight: 700;
            color: #0b74de;
            margin-bottom: 30px;
        }

        .newsletter-form {
            display: flex;
            max-width: 500px;
            margin: 0 auto 20px;
            gap: 0;
        }

        .email-input {
            flex: 1;
            padding: 12px 20px;
            border: 1px solid #d1d5db;
            border-radius: 8px 0 0 8px;
            font-size: 14px;
            outline: none;
            border-right: none;
        }

        .email-input:focus {
            border-color: #0b74de;
        }

        .subscribe-btn {
            background: #0b74de;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 0 8px 8px 0;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .subscribe-btn:hover {
            background: #0b74de;
        }

        .subscribe-btn::after {
            content: '>';
            font-weight: bold;
        }

        .checkbox-container {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 15px;
        }

        .checkbox {
            width: 16px;
            height: 16px;
        }

        .checkbox-label {
            font-size: 14px;
            color: #64748b;
        }

        .privacy-text {
            font-size: 12px;
            color: #94a3b8;
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.4;
        }

        .privacy-link {
            color: #0b74de;
            text-decoration: none;
        }

        .privacy-link:hover {
            text-decoration: underline;
        }

        .footer-content {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-brand {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo-icon {
            width: 32px;
            height: 32px;
            background: #0b74de;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 14px;
        }

        .logo-text {
            font-size: 20px;
            font-weight: 700;
            color: #1e293b;
        }

        .social-links {
            display: flex;
            gap: 12px;
        }

        .social-link {
            width: 36px;
            height: 36px;
            background: #f1f5f9;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #64748b;
            text-decoration: none;
            transition: all 0.2s;
        }

        .social-link:hover {
            background: #0b74de;
            color: white;
        }

        .footer-column {
            display: flex;
            flex-direction: column;
        }

        .footer-title {
            font-size: 16px;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 20px;
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .footer-link {
            color: #64748b;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.2s;
        }

        .footer-link:hover {
            color: #0b74de;
        }

        .footer-bottom {
            padding-top: 30px;
            border-top: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .copyright {
            font-size: 14px;
            color: #0b74de;
        }

        .scroll-top {
            width: 40px;
            height: 40px;
            background: #0b74de;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-decoration: none;
            transition: background 0.2s;
        }

        .scroll-top:hover {
            background: #0b74de;
        }

        /* Responsive Media Queries */
        @media (max-width: 768px) {
            .container {
                padding: 15px;
            }

            .main-content {
                padding: 15px;
            }

            .project-title h1 {
                font-size: 24px;
            }

            .project-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .project-meta {
                justify-content: flex-start;
            }

            .hamburger-menu {
                display: block;
            }

            nav {
                display: none;
            }

            .sidebar.active {
                display: block;
            }

            .logo a img {
                width: 85% !important;
            }

            header {
                align-items: unset !important;
                flex-wrap: unset !important;
                padding: 15px 14px;
                flex-direction: unset;
                border: 1px solid #eee;
            }

            .hamburger-menu {
                font-size: 24px;
            }

            .logo {
                margin-bottom: 0;
            }

            .dropdown {
                background: #f6f6f6;
                padding: 9px 15px !important;
            }

            .footer-container {
                padding: 0 20px;
            }

            .newsletter-form {
                flex-direction: column;
                gap: 12px;
            }

            .email-input {
                border-radius: 8px;
                border-right: 1px solid #d1d5db;
            }

            .subscribe-btn {
                border-radius: 8px;
            }

            .footer-content {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .footer-bottom {
                flex-direction: column;
                gap: 20px;
                text-align: center;
            }
        }

        @media (max-width: 576px) {
            .project-title h1 {
                font-size: 20px;
            }

            .project-meta {
                font-size: 11px;
            }

            .status-badge {
                font-size: 10px;
                padding: 3px 8px;
            }

            .description p,
            .description div,
            .description span,
            .description ul,
            .description ol,
            .description li {
                font-size: 13px;
            }

            .project-info {
                padding: 12px;
            }

            .info-label,
            .info-value {
                font-size: 12px;
            }

            .newsletter-title {
                font-size: 20px;
            }

            .breadcrumb {
                justify-content: center;
            }

            .project-logo {
                width: 50px;
                height: 50px;
                font-size: 18px;
            }
        }
    </style>
</head>
<body>
    <%- include("../../partials/frountHeader.ejs") %>
    <div class="container">
        <div class="main-content">
            <div class="breadcrumb">
                <a target="_blank" href="" class="socialMediaIcon">
                    <img style="width: 25px;" src="../../image/twitter.png" alt="Twitter">
                </a>
                <a target="_blank" href="<%=newsData.TelegramChannel%>" class="socialMediaIcon">
                    <img style="width: 25px;" src="../../image/telegram.png" alt="Telegram">
                </a>
                <a target="_blank" href="" class="socialMediaIcon">
                    <img style="width: 25px;" src="../../image/discord.png" alt="Discord">
                </a>
                <a target="_blank" href="" class="socialMediaIcon">
                    <img style="width: 25px;" src="../../image/facebook.png" alt="Facebook">
                </a>
                <a target="_blank" href="" class="socialMediaIcon">
                    <img style="width: 25px;" src="../../image/youtube.png" alt="YouTube">
                </a>
                <a target="_blank" href="" class="socialMediaIcon">
                    <img style="width: 25px;" src="../../image/instagram.png" alt="Instagram">
                </a>
            </div>
            <div class="project-header">
                <div class="project-title">
                    <h1><%= newsData.title %></h1>
                </div>
            </div>
            <div class="project-meta">
                <span class="status-badge easy">Easy</span>
                <span class="status-badge high-reward">High Reward</span>
                <span class="status-badge hot">Hot</span>
                <span class="status-badge epic">Epic</span>
                <span class="status-badge limited">Limited</span>
                <div class="meta-date">
                    <span class="info-value"><%= newsData.formattedPublishDate %></span>
                </div>
            </div>
            <div class="description">
                <img style="width: 100%; height: auto;" src="<%= newsData.newsBanner %>" alt="News Banner">
            </div>
            <div class="description">
                <%- newsData.description %>
            </div>
            <div class="project-info">
                <div class="info-row">
                    <span class="info-label">KryptoDesk Score:</span>
                    <span class="info-value">Very High</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Last update:</span>
                    <span class="info-value"><%= newsData.formattedPublishDate %></span>
                </div>
            </div>
        </div>
    </div>
    <%- include("../../partials/frountFooter.ejs") %>
    <script>
        document.getElementById('hamburger-menu')?.addEventListener('click', function () {
            document.getElementById('sidebar')?.classList.add('active');
        });
        document.getElementById('close-btn')?.addEventListener('click', function () {
            document.getElementById('sidebar')?.classList.remove('active');
        });
    </script>
</body>
</html>