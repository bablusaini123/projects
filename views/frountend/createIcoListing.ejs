    <script>
      function toggleDropdown() {
        const a = document.getElementById("multiselect").classList.toggle("active");
        // Optional: close if clicked outside
        document.addEventListener("click", function (e) {
          const multiselect = document.getElementById("multiselect");
          console.log("=====")
          if (!multiselect.contains(e.target)) {
            multiselect.classList.remove("active");
          }
        });
      }


      function multiselectCategory() {
        document.getElementById("multiselectCategory").classList.toggle("active");
        // Optional: close if clicked outside
        document.addEventListener("click", function (e) {
          const multiselect = document.getElementById("multiselectCategory");
          if (!multiselect.contains(e.target)) {
            multiselect.classList.remove("active");
          }
        });
      }


      function multiselectIndustry2(event) {
        event.stopPropagation(); // Prevent closing dropdown on this click

        const multiselect = document.getElementById("multiselectIndustry2");
        multiselect.classList.toggle("active");
      }

      // Add only one global click listener
      document.addEventListener("click", function (e) {
        const multiselect = document.getElementById("multiselectIndustry2");
        if (!multiselect.contains(e.target)) {
          multiselect.classList.remove("active");
        }
      });


    </script>

