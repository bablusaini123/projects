<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  


  <title>iNDEX</title>

  <style>
  

    .breadcrumb {
      font-size: 14px;
      margin: 22px 0px;
      letter-spacing: 1px;
      color: #555;
    }

    .breadcrumb a {
      color: #1a73e8;
      text-decoration: none;
    }

    .form-container {
      max-width: 950px;
      margin: auto;
      background: white;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
    }

    .form-group {
      margin-bottom: 20px;
    }

    label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
    }

    input[type="text"],
    input[type="url"],
    input[type="date"],
    select,
    .location {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
    }

    .inline-group {
      display: flex;
      gap: 15px;
    }

    .inline-group .form-group {
      flex: 1;
    }

    .upload-box {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px;
      border: 2px dashed #ccc;
      border-radius: 6px;
    }

    .upload-box .text {
      font-size: 14px;
      color: #333;
    }

    .upload-box .upload-btn {
      color: #0056d2;
      font-weight: bold;
      cursor: pointer;
    }

    .flag-select {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .flag-select img {
      width: 24px;
      height: 18px;
      border: 1px solid #ccc;
    }

    .timezone-box {
      border: 1px solid #ccc;
      border-radius: 6px;
      padding: 10px;
      font-size: 14px;
    }

    .event-type {
      display: inline-block;
      padding: 10px 15px;
      background: #f0f6ff;
      border-radius: 6px;
      font-weight: 500;
      border: 1px solid #d0e3ff;
      color: #0056d2;
    }



    #countryDropdown {
      border: 0;
      padding: 0;
      width: 100%;
    }

    .startDate {
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      width: 100%;
    }

    .checkbox-container label {
      display: inline-block;
      margin-right: 15px;
      /* horizontal gap */
      margin-bottom: 8px;
      /* vertical gap */
      cursor: pointer;
    }

    .multiselect-container {
      position: relative;

    }

    .multiselect-category {
      position: relative;

    }

    .multiselect-industry {
      position: relative;

    }

    .select-box {
      border: 1px solid #ccc;
      padding: 10px;
      border-radius: 6px;
      cursor: pointer;
    }

    .options-container {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      max-height: 200px;
      overflow-y: auto;
      border: 1px solid #ccc;
      border-top: none;
      background-color: white;
      z-index: 10;
      padding: 10px;
    }

    .options-container label {
      display: flex;
      align-items: center;
      margin-bottom: 8px;
      cursor: pointer;
    }

    .options-container label input {
      margin-right: 10px;
    }

    .multiselect-container.active .options-container {
      display: block;
    }

    .multiselect-category.active .options-container {
      display: block;
    }

    .multiselect-industry.active .options-container {
      display: block;
    }

    .decsTextarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
    }

    .eventBtn {
    padding: 10px 29px;
    background: #655de6;
    margin-left: auto;
    color: #fff;
    text-decoration: none;
    border-radius: 18px;
    font-weight: 600;
    border: navajowhite;
    }

    .sponsers {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .innerSpronsers {
      width: 30%;
      margin: 10px 0px;
    }

    .addButton {
      background: #e1ffed;
      font-size: 13px;
      border: navajowhite;
      border: solid 1px #d9d9d9;
      padding: 7px 13px;
      font-weight: 500;
      margin-top: 8px;
    }

    .input-row {
      display: flex;
      gap: 10px;
      margin-bottom: 10px;
    }

    .input-row input {
      flex: 1;
      padding: 5px;
    }

    .paid-inputs {
      display: none;
      margin-top: 15px;
    }

    .authorInput {
      width: 100%;
      padding: 10px;
    }

    .authorDiv {
      margin: 15px 0px;
      width: 50% !important;
    }
      #loader {
     display: none; 
      position: fixed;
      top: 0; left: 0;
      width: 100vw; height: 100vh;
      background: rgba(255, 255, 255, 0.8);
      z-index: 9999;
      justify-content: center;
      align-items: center;
      font-size: 2rem;
      color: #333;
      text-align: center;
    }
    #loader img{
      margin-top: 18%;
    }

     body {
            /* font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; */
            background: #fff;
            color: #111;
            font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif !important;
            overflow-x: hidden;
            margin: 0;

        }

        h1,
        h2,
        h3,
        p,
        span {
            font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif !important;

        }




        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 48px;
            border-bottom: 1px solid #eee;
        }

        .logo {
            display: flex;
            align-items: center;
            font-size: 32px;
            font-weight: bold;
            color: #111;
            margin: 0px !important;
        }

        .logo span {
            background: #0b74de;
            color: #fff;
            border-radius: 50%;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            font-size: 20px;
        }

        nav {
            display: flex;
            align-items: center;
            white-space: nowrap;
        }

        nav a {
            margin: 0 10px;
            text-decoration: none;
            color: #111;
            font-weight: 500;
            position: relative;
        }

        nav a:hover {
            color: #0b74de;
        }

        .dropdown {
            position: relative;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            min-width: 200px;
            z-index: 10;
            padding: 10px 0;
        }

        .dropdown-content a {
            display: block;
            padding: 10px 15px;
            color: #111;
            font-weight: 400;
            font-size: 14px;
            text-decoration: none;
        }

        .dropdown-content a:hover {
            background: #fafafa;
            color: #0b74de;
        }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        .download-btn {
            background: #0b74de;
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
        }
  </style>

</head>

