        <h4>Loading...</h4>
       
      </div>
    </section>

    <form class="mt-5" action="/createIcoListing" method="post" enctype="multipart/form-data" onsubmit="showLoader()"> 

      <section>
        <div class="container">
          <div class="form-container">
            <div class="form-group">
              <label>Toekn/Coin Title <span style="color:red">*</span></label>
              <input name="title" type="text" placeholder="Enter Token Title" required />
            </div>

            <div class="form-group">
              <label>Upload Logo</label>
              <div class="upload-box">
                <div class="text">
                  Drag and drop an image or <strong>1250 x 656</strong> (in pixels).<br />
                  PNG, JPEG, <strong>SVG</strong> are Supported
                </div>
                <input type="file" name="logo" required class="form-control">
              </div>
            </div>

             <div class="form-group">
              <label>Project Screenshots</label>
              <div class="upload-box">
                <div class="text">
                  Drag and drop an image or <strong>1250 x 656</strong> (in pixels).<br />
                  PNG, JPEG, <strong>SVG</strong> are Supported
                </div>
                <input type="file" name="projectSreenshot" required multiple class="form-control">
              </div>
            </div>

            <div class="inline-group">
              <div class="form-group">
                <label>Raise Funds</label>
                <input type="text" placeholder="Enter Raise Fund" name="raiseFund" />
              </div>
              <div class="form-group" style="opacity: 0;">
                <label>Extra <span style="color:red">*</span></label>
                <input type="text" placeholder="extra">
              </div>
            </div>

          

            <div class="inline-group">
              <div class="form-group">
                <label>Start Date</label>
                <input name="startDate" class="startDate" type="date" required />
              </div>
              <div class="form-group">
                <label>End Date</label>
                <input name="endDate" class="startDate" type="date" required />
              </div>

            </div>

              <div class="form-group">
              <label>Token Description <span style="color:red">*</span></label>
              <textarea required name="smallDescription" id="editor" class="decsTextarea ckeditor" rows="4"
                placeholder="Update full description of your token/coin"></textarea>
            </div>

            <!-- Token Overview -->


            <div>
              <label>Token/Coin Overview <span style="color:red">*</span></label>
              <div class="inline-group">
                <div class="form-group">
