    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <!-- show loader -->

    <script>
      function showLoader() {
        document.getElementById('loader').style.display = 'block';
      }
    </script>

    <!-- Handle dynamic tag input -->

    <script>
      // Handle dynamic tag input
      const tagsInput = document.getElementById('tagsInput');
      const addTagBtn = document.getElementById('addTagBtn');
      const tagsList = document.getElementById('tagsList');

      addTagBtn.addEventListener('click', () => {
        const tagValue = tagsInput.value.trim();

        // Check if tag is non-empty and not already in list
        if (tagValue && !tagsList.querySelector(`button[data-tag="${tagValue}"]`)) {
          // Create a new tag button item
          const tagBtn = document.createElement('button');
          tagBtn.setAttribute('data-tag', tagValue);
          tagBtn.classList.add('tag-btn');
          tagBtn.textContent = tagValue;

          // Create remove button for tag
          const removeTagBtn = document.createElement('button');
          removeTagBtn.classList.add('remove-btn');
          removeTagBtn.textContent = 'x';
          removeTagBtn.addEventListener('click', () => {
            tagBtn.remove();
          });

          // Append remove button to tag button
          tagBtn.appendChild(removeTagBtn);

          // Add the tag button to the tags container
          tagsList.appendChild(tagBtn);

          // Create a hidden input for this tag
          const hiddenInput = document.createElement('input');
          hiddenInput.type = 'hidden';
          hiddenInput.name = 'tags';  // This makes it an array-like structure
          hiddenInput.value = tagValue;

          // Append hidden input to the container
          hiddenTagsContainer.appendChild(hiddenInput);

          // Clear the input field after adding the tag

          // Clear input field after adding
          tagsInput.value = '';


        }
      });
    </script>

    <!-- multiselect category -->

    <script>
      function toggleDropdown() {
        const a = document.getElementById("multiselect").classList.toggle("active");
        // Optional: close if clicked outside
        document.addEventListener("click", function (e) {
          const multiselect = document.getElementById("multiselect");
          console.log("=====")
          if (!multiselect.contains(e.target)) {
            multiselect.classList.remove("active");
          }
        });
      }
    </script>

    <!-- tiny editor -->

    <script>
      // Initialize TinyMCE Editor
      document.addEventListener("DOMContentLoaded", function () {
        tinymce.init({
          selector: '#editor', // Targeting the ID of the textarea
          height: 500, // Set the editor height
          plugins: [
            'image', 'table', 'lists', 'link', 'advlist', 'wordcount', 'codesample', 'emoticons', 'searchreplace'
          ],
          toolbar: [
            'undo redo | bold italic underline | fontselect fontsizeselect | forecolor backcolor | alignleft aligncenter alignright alignjustify | outdent indent | numlist bullist | link image table | emoticons | codesample | fullscreen'
          ],
          images_upload_url: '/upload-image', // 👈 Your upload route
          automatic_uploads: true,
          images_upload_handler: function (blobInfo, success, failure) {
            var xhr, formData;

            xhr = new XMLHttpRequest();
            xhr.withCredentials = false;
            xhr.open('POST', '/addNews'); // 👈 This should match server

            xhr.onload = function () {
              if (xhr.status != 200) {
                failure('HTTP Error: ' + xhr.status);
                return;
              }

              var json = JSON.parse(xhr.responseText);

              if (!json || typeof json.location != 'string') {
                failure('Invalid JSON: ' + xhr.responseText);
                return;
              }

              success(json.location); // 👈 Should return image URL
            };

            formData = new FormData();
            formData.append('file', blobInfo.blob(), blobInfo.filename()); // 👈 Must match multer field

            xhr.send(formData);
          }
        });
      });
    </script>


