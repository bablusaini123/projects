      gap: 10px;
      margin-bottom: 10px;
    }

    .input-row input {
      flex: 1;
      padding: 5px;
    }

    .paid-inputs {
      display: none;
      margin-top: 15px;
    }

    .authorInput {
      width: 100%;
      padding: 10px;
    }

    .authorDiv {
      margin: 15px 0px;
      width: 50% !important;
    }

    #loader {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(255, 255, 255, 0.8);
      z-index: 9999;
      justify-content: center;
      align-items: center;
      font-size: 2rem;
      color: #333;
      text-align: center;
    }

    #loader img {
      margin-top: 18%;
    }

    /* Style input to look like a button */
    #tagNameInput {
      padding: 8px 12px;
      border: 1px solid #007BFF;
      border-radius: 20px;
      background-color: #f0f0f0;
      font-size: 14px;
      color: #007BFF;
      transition: background-color 0.3s ease, color 0.3s ease;
      cursor: pointer;
      width: 200px;
    }

    #tagNameInput:focus {
      outline: none;
      background-color: #007BFF;
      color: white;
    }

    /* Style for Add Tag button */
    #addTagBtn {
      padding: 8px 16px;
      background-color: #28a745;
      color: white;
      border: none;
      border-radius: 20px;
      font-size: 14px;
      cursor: pointer;
      margin: 13px 0px;
    }

    #addTagBtn:hover {
      background-color: #218838;
    }

    /* Style for dynamic tags (buttons) */
    .tag-btn {
      padding: 8px 12px;
      background-color: #e0f7e9;
      color: white;
      border: none;
      border-radius: 5px;
      font-size: 14px;
      cursor: pointer;

      display: flex;
      align-items: center;
      color: #2e7d32;
    }

    .tag-btn:hover {
      background-color: #abd7bc;
    }

    .tag-btn .remove-btn {
      background-color: #67ca6c;
      border-radius: 100%;
      color: white;
      font-size: 12px;
      margin-left: 12px;
      cursor: pointer;
      border: none;
      color: black;
      padding: 1px 7px;
    }

    .tag-btn .remove-btn:hover {
      background-color: #5bc260;
    }

    #tagsList {
      display: flex;
      gap: 19px;
      flex-wrap: wrap;
    }
     body {
