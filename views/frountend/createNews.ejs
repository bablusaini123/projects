        nav a:hover {
            color: #0b74de;
        }

        .dropdown {
            position: relative;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            min-width: 200px;
            z-index: 10;
            padding: 10px 0;
        }

        .dropdown-content a {
            display: block;
            padding: 10px 15px;
            color: #111;
            font-weight: 400;
            font-size: 14px;
            text-decoration: none;
        }

        .dropdown-content a:hover {
            background: #fafafa;
            color: #0b74de;
        }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        .download-btn {
            background: #0b74de;
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
        }
  </style>

</head>

<body>

