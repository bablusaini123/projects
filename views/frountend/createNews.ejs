  <title>iNDEX</title>

  <style>
    * {
      box-sizing: border-box;
    }

   

    .breadcrumb {
      font-size: 14px;
      margin: 22px 0px;
      letter-spacing: 1px;
      color: #555;
    }

    .breadcrumb a {
      color: #1a73e8;
      text-decoration: none;
    }

    .form-container {
      max-width: 700px;
      margin: auto;
      background: white;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
    }

    .form-group {
      margin-bottom: 20px;
    }

    label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
    }

    input[type="text"],
    input[type="url"],
    input[type="date"],
    select,
    .location {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
    }

    .inline-group {
      display: flex;
      gap: 15px;
    }

    .inline-group .form-group {
      flex: 1;
    }

    .upload-box {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px;
      border: 2px dashed #ccc;
      border-radius: 6px;
    }

    .upload-box .text {
      font-size: 14px;
      color: #333;
    }

    .upload-box .upload-btn {
      color: #0056d2;
      font-weight: bold;
      cursor: pointer;
    }

    .flag-select {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .flag-select img {
      width: 24px;
      height: 18px;
      border: 1px solid #ccc;
    }

    .timezone-box {
      border: 1px solid #ccc;
      border-radius: 6px;
      padding: 10px;
      font-size: 14px;
    }

    .event-type {
      display: inline-block;
      padding: 10px 15px;
      background: #f0f6ff;
      border-radius: 6px;
      font-weight: 500;
      border: 1px solid #d0e3ff;
      color: #0056d2;
    }



    #countryDropdown {
      border: 0;
      padding: 0;
      width: 100%;
    }

    .startDate {
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      width: 100%;
    }

    .checkbox-container label {
      display: inline-block;
      margin-right: 15px;
      /* horizontal gap */
      margin-bottom: 8px;
      /* vertical gap */
      cursor: pointer;
    }

    .multiselect-container {
      position: relative;

    }

    .select-box {
      border: 1px solid #ccc;
      padding: 10px;
      border-radius: 6px;
      cursor: pointer;
    }

    .options-container {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      max-height: 200px;
      overflow-y: auto;
      border: 1px solid #ccc;
      border-top: none;
      background-color: white;
      z-index: 10;
      padding: 10px;
    }

    .options-container label {
      display: flex;
      align-items: center;
      margin-bottom: 8px;
      cursor: pointer;
    }

    .options-container label input {
      margin-right: 10px;
    }

    .multiselect-container.active .options-container {
      display: block;
    }

    .decsTextarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
    }

    .eventBtn {
      padding: 9px 31px;
      background: #f9d3d3;
      margin-left: auto;
      color: #000;
      text-decoration: none;
      border-radius: 18px;
      font-weight: 400;
      border: navajowhite;
      margin: 19px 0px;
    }



    .addButton {
      background: #e1ffed;
      font-size: 13px;
      border: navajowhite;
      border: solid 1px #d9d9d9;
      padding: 7px 13px;
      font-weight: 500;
      margin-top: 8px;
    }

    .input-row {
