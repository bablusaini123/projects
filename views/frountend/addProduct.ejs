                        <select class="form-select form-control" id="productType" required name="productType">
                            <option value="" disabled selected>Select Product Type</option>
                            <option value="New">New</option>
                            <option value="Refurbished">Refurbished</option>
                        </select>
                    </div>

                    <!-- Power -->
                    <div class="mb-3">
                        <label for="power" class="form-label">Power</label>
                        <input type="text" class="form-control" id="power" required name="power">
                    </div>

                    <!-- HashRate -->
                    <div class="mb-3">
                        <label for="hashRate" class="form-label">HashRate</label>
                        <input type="text" class="form-control" id="hashRate" required name="hashRate">
                    </div>

                    <!-- Overview -->
                    <div class="mb-3">
                        <label for="overview" class="form-label">Overview</label>
                        <textarea id="editors" name="overview" placeholder="Write your overView here..."></textarea>
                    </div>

                    <!-- Product Images -->
                    <div class="mb-3">
                        <label for="productImages" class="form-label">Product Images</label>
                        <input type="file" class="form-control" id="productImages" multiple required
                            name="productImages">
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea id="editors2" name="description"
                            placeholder="Write your Description here..."></textarea>
                    </div>

                    <!-- Description Image -->
                    <div class="mb-3">
                        <label for="descriptionImage" class="form-label">Description Image</label>
                        <input name="descriptionImage" type="file" class="form-control" id="descriptionImage" required>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>
            </div>
        </div>


</body>

<script>
    function toggleDropdown() {
        const a = document.getElementById("multiselect").classList.toggle("active");
        // Optional: close if clicked outside
        document.addEventListener("click", function (e) {
            const multiselect = document.getElementById("multiselect");
            console.log("=====")
            if (!multiselect.contains(e.target)) {
                multiselect.classList.remove("active");
            }
        });
    }
</script>

